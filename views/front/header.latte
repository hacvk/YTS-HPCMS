<div class="Top_dyseo">
    <div class="today">
        <dl class="auto auto_1150 clearfix">
            <dd><a href="/" class="gethome">返回首页</a></dd>
            <dt class="fl">您好！欢迎您访问{$hospitalName ?? ''}官网</dt>
        </dl>
    </div>

    <div class="header-top auto auto_1150">
        <div class="logo"><a href="/"><img src="{setting('site_logo', '')}"></a></div>

        <dl class="header-right">
            <dt>
                <form method="get" action="/search/">
                    <input type="text" class="text" id="TopKey" name="keyword" value="">
                    <input id="TopBtn" class="btn" type="submit" value="查找" class="seabtn">
                </form>
            </dt>
            <dd id="open_menu"><i></i></dd>
        </dl>

        <script>
            if($(window).width() < 769) {
                $('.search-btn').click(function() {
                    $('.header-right dt').stop().slideToggle(300);
                })
            }
        </script>
    </div>

    <div class="header-bottom">
        <header class="header auto auto_1150">
            <nav class="header-menu sub-vertical clearfix sub-slideDown">
                <ul class="ul clearfix">
                    <li class="home"><em><a href="/">首页</a></em></li>
                    {ifset $navItems}
                        {foreach $navItems as $item}
                            <li>
                                <em><a href="{$item['url']}" class="{$item['class'] ?? ''}">{$item['name']}</a></em>
                                {if !empty($item['children'])}
                                    <div class="sub">
                                        <div class="sub-menu">
                                            <dl>
                                                {foreach $item['children'] as $child}
                                                    <dt><a href="{$child['url']}" class="{$child['class'] ?? ''}">{$child['name']}</a></dt>
                                                {/foreach}
                                            </dl>
                                        </div>
                                    </div>
                                {/if}
                            </li>
                        {/foreach}
                    {/ifset}
                </ul>
            </nav>
        </header>
    </div>
</div>
