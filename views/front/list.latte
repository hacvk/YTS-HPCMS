{extends 'layout.latte'}

{block head}
    <link rel="stylesheet" href="{asset('static/css/fontawesome/all.min.css')}" />
{/block}

{block content}
<div class="Banner_dy">
    {var $bannerUrl = isset($category) ? category_banner($category['id'], asset('uploads/images/nullbanner.jpg')) : asset('static/picture/20210322110902915.jpg')}
    <span style="background-image:url({$bannerUrl})"></span>
    <img src="{$bannerUrl}" alt="">
</div>

<div class="crumbs">
    <div class="auto auto_1150"> <em>您的当前位置：</em>{ifset $breadcrumbs}{foreach $breadcrumbs as $crumb}{if $iterator->first}{else}&nbsp;&gt;&nbsp;{/if}<a href="{$crumb['url']}">{$crumb['title']}</a>{/foreach}{else}首页 > {$category['name']}{/ifset} </div>
</div>

<div class="auto auto_1150">
    <div class="list-container">
        <div class="w22 fl">
            {include 'sidebar.latte'}
        </div>
        
        <div class="w75 fr">
            <!-- 文章列表统计 -->
            <div class="list-stats">
                <div class="list-result-count">
                    共 <span class="result-number">{$articles['total'] ?? 0}</span> 篇文章，分类 "<span class="category-name">{$category['name'] ?? ''}</span>"
                    {if ($articles['total'] ?? 0) > 0}
                    <span class="current-page">（第 {$currentPage ?? 1} 页）</span>
                    {/if}
                </div>
            </div>
            
            <!-- 文章列表 -->
            {ifset $articles}
            <div class="article-list">
                {foreach $articles['list'] as $a}
                <div class="article-item">
                    <h4 class="article-title">
                        <a href="/article/{$a['id']}" class="text-decoration-none">{$a['title']}</a>
                    </h4>
                    <div class="article-meta">
                        <span class="publish-date">发布日期：{$a['published_at']|noescape}</span>
                        <span class="view-count">浏览量：{$a['views'] ?? 0} 次</span>
                        <span class="article-type badge">文章</span>
                    </div>
                </div>
                {/foreach}
            </div>
            {/ifset}
            
            <!-- 分页 -->
            <div class="pagination-wrapper">
                <div class="pagination">
                    {var $totalPages = ceil(($articles['total'] ?? 0) / ($limit ?? 10))}
                    {var $startPage = max(1, $currentPage - 4)}
                    {var $endPage = min($totalPages, $startPage + 8)}
                    
                    {if $currentPage > 1}
                    <a href="/c/{$category['slug']}/page/{($currentPage - 1)}" class="page-link prev-page">
                        <i class="fas fa-chevron-left"></i> 上一页
                    </a>
                    {/if}
                    
                    {if $startPage > 1}
                    <a href="/c/{$category['slug']}/page/1" class="page-link">1</a>
                    {if $startPage > 2}
                    <span class="page-ellipsis">...</span>
                    {/if}
                    {/if}
                    
                    {for $i = $startPage; $i <= $endPage; $i++}
                    {if $i == $currentPage}
                    <span class="page-current">{$i}</span>
                    {else}
                    <a href="/c/{$category['slug']}/page/{$i}" class="page-link">{$i}</a>
                    {/if}
                    {/for}
                    
                    {if $endPage < $totalPages}
                    {if $endPage < $totalPages - 1}
                    <span class="page-ellipsis">...</span>
                    {/if}
                    <a href="/c/{$category['slug']}/page/{$totalPages}" class="page-link">{$totalPages}</a>
                    {/if}
                    
                    {if $currentPage < $totalPages}
                    <a href="/c/{$category['slug']}/page/{($currentPage + 1)}" class="page-link next-page">
                        下一页 <i class="fas fa-chevron-right"></i>
                    </a>
                    {/if}
                </div>
            </div>
        </div>
        
        <div class="clear"></div>
    </div>
</div>

<style>
.list-container {
    padding: 20px 0;
}

.list-stats {
    margin-bottom: 30px;
    padding: 15px 20px;
    background: #f5f9fd;
    border-radius: 4px;
    border-left: 4px solid #0068b7;
}

.list-result-count {
    font-size: 16px;
    color: #333;
}

.result-number {
    font-weight: bold;
    color: #0068b7;
    font-size: 18px;
}

.category-name {
    color: #0068b7;
    font-weight: 600;
    background: #e6f0ff;
    padding: 2px 6px;
    border-radius: 3px;
}

.current-page {
    color: #666;
    font-size: 14px;
    margin-left: 10px;
}

.article-list {
    margin-bottom: 30px;
}

.article-item {
    padding: 20px;
    margin-bottom: 20px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    transition: all 0.3s ease;
    background: #fff;
}

.article-item:hover {
    border-color: #0068b7;
    box-shadow: 0 5px 15px rgba(0, 104, 183, 0.1);
    transform: translateY(-2px);
}

.article-title {
    margin: 0 0 12px 0;
    font-size: 18px;
}

.article-title a {
    color: #0068b7;
    text-decoration: none;
    font-weight: 600;
}

.article-title a:hover {
    color: #005299;
    text-decoration: underline;
}

.article-meta {
    margin-bottom: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 14px;
    color: #666;
}

.publish-date,
.view-count {
    display: flex;
    align-items: center;
}

.publish-date::before {
    content: "📅";
    margin-right: 5px;
    color: #0068b7;
}

.view-count::before {
    content: "👁️";
    margin-right: 5px;
    color: #0068b7;
}

.article-type {
    background: #0068b7;
    color: white;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: normal;
    margin-left: auto;
}

.pagination-wrapper {
    text-align: center;
    margin: 30px 0;
}

.pagination {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    margin: 0;
}

.page-link {
    display: inline-block;
    padding: 8px 14px;
    background: #fff;
    border: 1px solid #ddd;
    color: #333;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.3s ease;
    font-size: 14px;
}

.page-link:hover {
    background: #0068b7;
    color: #fff;
    border-color: #0068b7;
}

.page-current {
    display: inline-block;
    padding: 8px 14px;
    background: #0068b7;
    color: #fff;
    border: 1px solid #0068b7;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}

.prev-page,
.next-page {
    background: #f5f9fd;
    color: #0068b7;
}

.prev-page:hover,
.next-page:hover {
    background: #0068b7;
    color: #fff;
}

.page-ellipsis {
    padding: 8px 5px;
    color: #999;
}

/* 响应式设计 */
@media (max-width: 768px) {
    .article-meta {
        flex-direction: column;
        gap: 5px;
    }
    
    .article-type {
        margin-left: 0;
    }
    
    .article-title {
        font-size: 16px;
    }
    
    .page-link,
    .page-current {
        padding: 6px 10px;
        font-size: 13px;
    }
    
    .article-item {
        padding: 15px;
    }
    
    .w22.fl {
        width: 100%;
        float: none;
        margin-bottom: 20px;
    }
    
    .w75.fr {
        width: 100%;
        float: none;
    }
}

@media (max-width: 480px) {
    .publish-date::before,
    .view-count::before {
        display: none;
    }
    
    .pagination {
        flex-wrap: wrap;
    }
    
    .prev-page,
    .next-page {
        flex-grow: 1;
        text-align: center;
    }
}
</style>
{/block}