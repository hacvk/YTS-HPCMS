{* views/front/doctorlist.latte *}
{var $disable_legacy_css = true}
{extends 'layout.latte'}



{block head}
    <meta name="keywords" content="{ifset $category}{$category['keywords'] ?? ''}{/ifset}" />
    <meta name="description" content="{ifset $category}{$category['description'] ?? ''}{/ifset}" />
{/block}

{block content}
<!-- Banner -->
<div class="Banner_dy">
    {var $bannerUrl = isset($category) ? category_banner($category['id'], asset('static/picture/20210322110902915.jpg')) : asset('static/picture/20210322110902915.jpg')}
    <span style="background-image:url({$bannerUrl})"></span>
    <img src="{$bannerUrl}" alt="">
</div>
<!-- Banner End -->

<!-- breadcrumbs -->
<div class="crumbs">
    <div class="auto auto_1150">
        <em>您的当前位置：</em>{ifset $breadcrumbs}{foreach $breadcrumbs as $crumb}{if $iterator->first}{else}&nbsp;&raquo;&nbsp;{/if}<a href="{$crumb['url']}">{$crumb['title']}</a>{/foreach}{/ifset}
    </div>
</div>

<div class="auto auto_1150">
    <div class="w22 fl">
        {include 'sidebar.latte'}
    </div>
    <div class="w75 fr">
        <!-- 筛选功能 -->
        <div class="doctor-filter">
            <div class="filter-header">
                <span class="filter-label">筛选：</span>
                <button type="button" class="btn-clear-filter">
                    <i class="bi bi-x"></i> 清空筛选
                </button>
            </div>
            
            <!-- 所在科室筛选 -->
            <div class="filter-section">
                <div class="filter-title">所在科室：</div>
                {var $deptGroups = $filterData['departments'] ?? []}
                {var $selectedDeptIds = $filterData['selected_depts'] ?? []}
                {var $activeDeptGroupId = (int)($filterData['active_dept_group'] ?? 0)}
                {if $activeDeptGroupId === 0 && count($deptGroups) > 0}
                    {var $activeDeptGroupId = (int)($deptGroups[0]['id'] ?? 0)}
                {/if}
                {if count($deptGroups) > 0}
                    <div class="dept-tabs">
                        {foreach $deptGroups as $deptGroup}
                            {var $deptGroupId = (int)($deptGroup['id'] ?? 0)}
                            <a href="#" class="dept-tab{if $deptGroupId === $activeDeptGroupId} active{/if}" data-tab="dept-{$deptGroupId}">{$deptGroup['name'] ?? ''}</a>
                        {/foreach}
                    </div>
                    {foreach $deptGroups as $deptGroup}
                        {var $deptGroupId = (int)($deptGroup['id'] ?? 0)}
                        {var $deptItems = $deptGroup['items'] ?? []}
                        <div class="dept-grid dept-group{if $deptGroupId === $activeDeptGroupId} active{/if}" id="dept-{$deptGroupId}"{if $deptGroupId !== $activeDeptGroupId} style="display:none;"{/if}>
                            {if count($deptItems) > 0}
                                {foreach $deptItems as $dept}
                                    {var $deptId = (int)($dept['id'] ?? 0)}
                                    <label class="dept-item">
                                        <input type="checkbox" name="dept" value="{$deptId}" {if in_array($deptId, $selectedDeptIds)}checked{/if}>
                                        <span>{$dept['title'] ?? $dept['name'] ?? ''}</span>
                                    </label>
                                {/foreach}
                            {else}
                                <div style="padding:6px 0;color:#888;">暂无科室</div>
                            {/if}
                        </div>
                    {/foreach}
                {/if}
            </div>
            
            <!-- 职称筛选 -->
            <div class="filter-section">
                <div class="filter-title">职称：</div>
                <div class="title-grid">
                    {var $titles = $filterData['titles'] ?? []}
                    {var $selectedTitles = $filterData['selected_titles'] ?? []}
                    {if count($titles) > 0}
                        {foreach $titles as $titleItem}
                            <label class="title-item">
                                <input type="checkbox" name="title" value="{$titleItem}" {if in_array($titleItem, $selectedTitles)}checked{/if}>
                                <span>{$titleItem}</span>
                            </label>
                        {/foreach}
                    {/if}
                </div>
            </div>
            
            <!-- 医师信息搜索 -->
            <div class="filter-section search-section">
                <div class="search-wrapper">
                    <span class="filter-title">医师信息</span>
                    <div class="search-box">
                        <input type="text" id="doctor-search" class="search-input" placeholder="搜索疾病或者医生姓名" value="{$filterData['keyword'] ?? ''}">
                        <button type="button" class="btn-search">
                            <i class="bi bi-search"></i> 搜索
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="Doctor_list">
            <ul class="ul clearfix">
                {var $list = $articles['list'] ?? []}
                {if count($list) > 0}
                    {foreach $list as $a}
                        {var $deptName = ''}
                        {if isset($a['keshi']) && is_array($a['keshi']) && count($a['keshi']) > 0}
                            {var $deptName = $a['keshi'][0][2] ?? ''}
                        {/if}
                        {var $titleText = $a['zhicheng'] ?? ''}
                        <li data-dept-id="{$deptId}" data-title="{$titleText}">
                            <div class="ytable">
                                <div class="pic ytable-cell"><a href="{$a['link'] ?? '/article/' . ($a['id'] ?? '')}"><img src="{$a['pic'] ?? $a['cover_img'] ?? ''}" width="150" height="210"></a></div>
                                <div class="txt ytable-cell">
                                    <h3 class="dot">
                                        <a href="{$a['link'] ?? '/article/' . ($a['id'] ?? '')}">{$a['title'] ?? ''}</a>
                                        {if $titleText}<span>{$titleText}</span>{/if}
                                    </h3>
                                    <aside>
                                        {if isset($a['keshi']) && is_array($a['keshi']) && count($a['keshi']) > 0}
                                            {foreach $a['keshi'] as $dept}
                                                {if is_array($dept) && isset($dept[2])}
                                                    <span>{$dept[2]}</span>{if !$iterator->last}<br>{/if}
                                                {/if}
                                            {/foreach}
                                        {/if}
                                    </aside>
                                    <div class="word"><p class="dot3">{$a['description'] ?? $a['summary'] ?? $a['shanchang'] ?? ''}</p></div>
                                </div>
                            </div>
                            <div class="btnDiv">
                                <input type="button" value="预约专家" onclick="window.location.href='{$onlineServiceUrl ?? '#'}'">
                                <a href="{$a['link'] ?? '/article/' . ($a['id'] ?? '')}" class="more">查看详细</a>
                            </div>
                        </li>
                    {/foreach}
                {else}
                    <li style="padding:20px 0;text-align:center;">暂无专家信息</li>
                {/if}
            </ul>
        </div>
        <div class="pagelist">
            {ifset $pagination}{$pagination|noescape}{/ifset}
        </div>
    </div>
    <div class="clear"></div>
</div>
{/block}

{block scripts}
<script nonce="{$csp_nonce}" type="text/javascript" src="{asset('static/front/js/doctor-filter.js')}"></script>
{/block}
