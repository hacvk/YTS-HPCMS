{* views/front/doctorlist.latte *}
{extends 'layout.latte'}

{block title}{ifset $category}{($category['name'] ?? '专家列表')}{else}专家列表{/ifset} - {$config['site']['title'] ?? ''}{/block}

{block head}
    <meta name="keywords" content="{ifset $category}{$category['keywords'] ?? ''}{/ifset}" />
    <meta name="description" content="{ifset $category}{$category['description'] ?? ''}{/ifset}" />
{/block}

{block content}
<!-- Banner -->
<div class="Banner_dy">
    {var $bannerUrl = isset($category) ? category_banner($category['id'], asset('static/picture/20210322110902915.jpg')) : asset('static/picture/20210322110902915.jpg')}
    <span style="background-image:url({$bannerUrl})"></span>
    <img src="{$bannerUrl}" alt="">
</div>
<!-- Banner End -->

<!-- breadcrumbs -->
<div class="crumbs">
    <div class="auto auto_1150">
        <em>您的当前位置：</em>{ifset $breadcrumbs}{foreach $breadcrumbs as $crumb}{if $iterator->first}{else}&nbsp;&raquo;&nbsp;{/if}<a href="{$crumb['url']}">{$crumb['title']}</a>{/foreach}{/ifset}
    </div>
</div>

<div class="auto auto_1150">
    <div class="w22 fl">
        {include 'sidebar.latte'}
    </div>
    <div class="w75 fr">
        <!-- 筛选功能 -->
        <div class="doctor-filter">
            <div class="filter-header">
                <span class="filter-label">筛选：</span>
                <button type="button" class="btn-clear-filter">
                    <i class="bi bi-x"></i> 清空筛选
                </button>
            </div>
            
            <!-- 所在科室筛选 -->
            <div class="filter-section">
                <div class="filter-title">所在科室：</div>
                <div class="dept-tabs">
                    <button type="button" class="dept-tab active" data-tab="clinical">临床科室</button>
                    <button type="button" class="dept-tab" data-tab="medical_tech">医技科室</button>
                </div>
                <div class="dept-grid" id="clinical-depts">
                    {var $clinicalDepts = $filterData['departments']['clinical'] ?? []}
                    {if count($clinicalDepts) > 0}
                        {foreach $clinicalDepts as $dept}
                            <label class="dept-item">
                                <input type="checkbox" name="dept" value="{$dept['id']}">
                                <span>{$dept['title']}</span>
                            </label>
                        {/foreach}
                    {/if}
                </div>
                <div class="dept-grid" id="medical_tech-depts" style="display: none;">
                    {var $medicalTechDepts = $filterData['departments']['medical_tech'] ?? []}
                    {if count($medicalTechDepts) > 0}
                        {foreach $medicalTechDepts as $dept}
                            <label class="dept-item">
                                <input type="checkbox" name="dept" value="{$dept['id']}">
                                <span>{$dept['title']}</span>
                            </label>
                        {/foreach}
                    {/if}
                </div>
            </div>
            
            <!-- 职称筛选 -->
            <div class="filter-section">
                <div class="filter-title">职称：</div>
                <div class="title-grid">
                    {var $titles = $filterData['titles'] ?? []}
                    {if count($titles) > 0}
                        {foreach $titles as $titleItem}
                            <label class="title-item">
                                <input type="checkbox" name="title" value="{$titleItem}">
                                <span>{$titleItem}</span>
                            </label>
                        {/foreach}
                    {/if}
                </div>
            </div>
            
            <!-- 医师信息搜索 -->
            <div class="filter-section search-section">
                <div class="search-wrapper">
                    <span class="filter-title">医师信息</span>
                    <div class="search-box">
                        <input type="text" id="doctor-search" class="search-input" placeholder="搜索疾病或者医生姓名">
                        <button type="button" class="btn-search">
                            <i class="bi bi-search"></i> 搜索
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="Doctor_list">
            <ul class="ul clearfix">
                {var $list = $articles['list'] ?? []}
                {if count($list) > 0}
                    {foreach $list as $a}
                        <li>
                            <div class="ytable">
                                <div class="pic ytable-cell"><a href="{$a['link'] ?? '/article/' . ($a['id'] ?? '')}"><img src="{$a['pic'] ?? $a['cover_img'] ?? ''}"></a></div>
                                <div class="txt ytable-cell">
                                    <h3 class="dot">
                                        <a href="{$a['link'] ?? '/article/' . ($a['id'] ?? '')}">{$a['title'] ?? ''}</a>
                                        {ifset $a['zhicheng']}<span>{$a['zhicheng']}</span>{/ifset}
                                    </h3>
                                    <aside>
                                        {var $deptList = $a['keshi'] ?? []}
                                        {if is_array($deptList) && count($deptList) > 0}
                                            {foreach $deptList as $dept}
                                                {if is_array($dept)}
                                                    <a href="/article/{$dept[1] ?? ''}">{$dept[2] ?? '查看'}</a><br>
                                                {/if}
                                            {/foreach}
                                        {/if}
                                    </aside>
                                    <div class="word"><p class="dot3">{$a['description'] ?? $a['summary'] ?? $a['shanchang'] ?? ''|noescape}</p></div>
                                </div>
                            </div>
                            <div class="btnDiv">
                                <input type="button" value="预约专家" onclick="window.location.href='{$onlineServiceUrl ?? '#'}'">
                                <a href="{$a['link'] ?? '/article/' . ($a['id'] ?? '')}" class="more">查看详细</a>
                            </div>
                        </li>
                    {/foreach}
                {else}
                    <li style="padding:20px 0;text-align:center;">暂无专家信息</li>
                {/if}
            </ul>
        </div>
        <div class="pagelist">
            {ifset $pagination}{$pagination|noescape}{/ifset}
        </div>
    </div>
    <div class="clear"></div>
</div>
{/block}

{block scripts}
<script type="text/javascript" src="{asset('static/front/js/doctor-filter.js')}"></script>
{/block}
