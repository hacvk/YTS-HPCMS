{extends 'layout.latte'}

{block head}
    <link rel="stylesheet" href="{asset('static/css/fontawesome/all.min.css')}" />
{/block}

{block content}
<div class="auto auto_1150">
    <div class="search-container">
        <!-- 搜索结果统计 -->
        {if !empty($keyword)}
        <div class="search-stats">
            {if isset($blocked) && $blocked}
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> 搜索请求被限制
                {if isset($blocked_reason)}
                <br><small>原因：{$blocked_reason}</small>
                {/if}
            </div>
            {else}
            <div class="search-result-count">
                找到 <span class="result-number">{$total}</span> 个结果，关于 "<span class="search-keyword">{$keyword}</span>"
                {if $total > 0}
                <span class="current-page">（第 {$page} 页）</span>
                {/if}
            </div>
            {/if}
        </div>
        {/if}

        <!-- 搜索结果列表 -->
        {if !empty($results)}
        <div class="search-results">
            {foreach $results as $result}
            <div class="search-result-item">
                <h4 class="search-result-title">
                    <a href="{$result['url']}" class="text-decoration-none">{$result['title']}</a>
                </h4>
                <div class="search-result-meta">
                    <span class="publish-date">发布日期：{$result['published_at']|noescape}</span>
                    <span class="view-count">浏览量：{$result['views']} 次</span>
                    <span class="result-type badge">{($result['type'] ?? '文章')|noescape}</span>
                </div>
                <div class="search-result-summary">
                    {$result['summary']|noescape}
                </div>
            </div>
            {/foreach}
        </div>

        <!-- 分页 -->
        {if $total > $limit}
        <div class="pagination-wrapper">
            <div class="pagination">
                {var $totalPages = ceil($total / $limit)}
                {var $startPage = max(1, $page - 4)}
                {var $endPage = min($totalPages, $startPage + 8)}

                {if $page > 1}
                <a href="/search/?keyword={$keyword}&page={($page - 1)}" class="page-link prev-page">
                    <i class="fas fa-chevron-left"></i> 上一页
                </a>
                {/if}

                {if $startPage > 1}
                <a href="/search/?keyword={$keyword}&page=1" class="page-link">1</a>
                {if $startPage > 2}
                <span class="page-ellipsis">...</span>
                {/if}
                {/if}

                {for $i = $startPage; $i <= $endPage; $i++}
                {if $i == $page}
                <span class="page-current">{$i}</span>
                {else}
                <a href="/search/?keyword={$keyword}&page={$i}" class="page-link">{$i}</a>
                {/if}
                {/for}

                {if $endPage < $totalPages}
                {if $endPage < $totalPages - 1}
                <span class="page-ellipsis">...</span>
                {/if}
                <a href="/search/?keyword={$keyword}&page={$totalPages}" class="page-link">{$totalPages}</a>
                {/if}

                {if $page < $totalPages}
                <a href="/search/?keyword={$keyword}&page={($page + 1)}" class="page-link next-page">
                    下一页 <i class="fas fa-chevron-right"></i>
                </a>
                {/if}
            </div>
        </div>
        {/if}

        {else}
        {if !empty($keyword)}
        <div class="no-results">
            <div class="no-results-icon">
                <i class="fas fa-search"></i>
            </div>
            <h3>未找到相关内容</h3>
            <p>我们无法找到与 "<span class="search-keyword">{$keyword}</span>" 相关的内容</p>
            <div class="suggestions">
                <h4>建议：</h4>
                <ul>
                    <li>检查拼写是否有误</li>
                    <li>尝试使用其他关键词</li>
                    <li>尝试使用更通用的关键词</li>
                </ul>
            </div>
        </div>
        {/if}
        {/if}

        <!-- 热门搜索（可选） -->
        {if empty($keyword)}
        <div class="hot-searches">
            <h3 class="section-title">热门搜索</h3>
            <div class="hot-search-tags">
                {ifset $hotKeywords}
                {foreach $hotKeywords as $hotKeyword}
                <a href="/search/?keyword={$hotKeyword}" class="hot-search-tag">{$hotKeyword}</a>
                {/foreach}
                {/ifset}
            </div>
        </div>
        {/if}
    </div>
</div>

<style>
.search-container {
    padding: 20px 0;
}

.search-stats {
    margin-bottom: 30px;
    padding: 15px 20px;
    background: #f5f9fd;
    border-radius: 4px;
    border-left: 4px solid #0068b7;
}

.search-result-count {
    font-size: 16px;
    color: #333;
}

.result-number {
    font-weight: bold;
    color: #0068b7;
    font-size: 18px;
}

.search-keyword {
    color: #0068b7;
    font-weight: 600;
    background: #e6f0ff;
    padding: 2px 6px;
    border-radius: 3px;
}

.current-page {
    color: #666;
    font-size: 14px;
    margin-left: 10px;
}

.search-results {
    margin-bottom: 30px;
}

.search-result-item {
    padding: 20px;
    margin-bottom: 20px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    transition: all 0.3s ease;
    background: #fff;
}

.search-result-item:hover {
    border-color: #0068b7;
    box-shadow: 0 5px 15px rgba(0, 104, 183, 0.1);
    transform: translateY(-2px);
}

.search-result-title {
    margin: 0 0 12px 0;
    font-size: 18px;
}

.search-result-title a {
    color: #0068b7;
    text-decoration: none;
    font-weight: 600;
}

.search-result-title a:hover {
    color: #005299;
    text-decoration: underline;
}

.search-result-meta {
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid #eee;
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 14px;
    color: #666;
}

.publish-date,
.view-count {
    display: flex;
    align-items: center;
}

.publish-date::before {
    content: "📅";
    margin-right: 5px;
    color: #0068b7;
}

.view-count::before {
    content: "👁️";
    margin-right: 5px;
    color: #0068b7;
}

.result-type {
    background: #0068b7;
    color: white;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: normal;
    margin-left: auto;
}

.search-result-summary {
    color: #666;
    line-height: 1.7;
    font-size: 15px;
}

.pagination-wrapper {
    text-align: center;
    margin: 30px 0;
}

.pagination {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    margin: 0;
}

.page-link {
    display: inline-block;
    padding: 8px 14px;
    background: #fff;
    border: 1px solid #ddd;
    color: #333;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.3s ease;
    font-size: 14px;
}

.page-link:hover {
    background: #0068b7;
    color: #fff;
    border-color: #0068b7;
}

.page-current {
    display: inline-block;
    padding: 8px 14px;
    background: #0068b7;
    color: #fff;
    border: 1px solid #0068b7;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}

.prev-page,
.next-page {
    background: #f5f9fd;
    color: #0068b7;
}

.prev-page:hover,
.next-page:hover {
    background: #0068b7;
    color: #fff;
}

.page-ellipsis {
    padding: 8px 5px;
    color: #999;
}

.no-results {
    text-align: center;
    padding: 50px 20px;
    background: #f9f9f9;
    border-radius: 8px;
    margin: 30px 0;
}

.no-results-icon {
    font-size: 60px;
    color: #ccc;
    margin-bottom: 20px;
}

.no-results h3 {
    color: #333;
    margin-bottom: 15px;
}

.no-results p {
    font-size: 16px;
    color: #666;
    margin-bottom: 25px;
}

.suggestions {
    text-align: left;
    max-width: 400px;
    margin: 0 auto;
}

.suggestions h4 {
    color: #333;
    margin-bottom: 10px;
}

.suggestions ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.suggestions li {
    padding: 5px 0;
    padding-left: 20px;
    position: relative;
    color: #666;
}

.suggestions li::before {
    content: "✅";
    position: absolute;
    left: 0;
    color: #0068b7;
}

.hot-searches {
    margin-top: 40px;
}

.section-title {
    font-size: 20px;
    color: #0068b7;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #0068b7;
}

.hot-search-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.hot-search-tag {
    display: inline-block;
    padding: 8px 16px;
    background: #f5f9fd;
    color: #0068b7;
    border: 1px solid #0068b7;
    border-radius: 20px;
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s ease;
}

.hot-search-tag:hover {
    background: #0068b7;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 3px 8px rgba(0, 104, 183, 0.2);
}

/* 响应式设计 */
@media (max-width: 768px) {
    .auto_1150 {
        width: auto;
        padding: 0 15px;
    }
    
    .search-result-meta {
        flex-direction: column;
        gap: 5px;
    }
    
    .result-type {
        margin-left: 0;
    }
    
    .search-result-title {
        font-size: 16px;
    }
    
    .page-link,
    .page-current {
        padding: 6px 10px;
        font-size: 13px;
    }
    
    .search-result-item {
        padding: 15px;
    }
    
    .hot-search-tag {
        padding: 6px 12px;
        font-size: 13px;
    }
}

@media (max-width: 480px) {
    .search-result-meta {
        font-size: 13px;
    }
    
    .publish-date::before,
    .view-count::before {
        display: none;
    }
    
    .pagination {
        flex-wrap: wrap;
    }
    
    .prev-page,
    .next-page {
        flex-grow: 1;
        text-align: center;
    }
}
</style>
{/block}
