{var $disable_legacy_css = true}
{extends 'layout.latte'}

{block head}
    <link rel="stylesheet" href="{asset('static/front/css/front-core.css')}" />
    <link rel="stylesheet" href="{asset('static/front/css/front-layout.css')}" />
    <link rel="stylesheet" href="{asset('static/front/css/front-widgets.css')}" />
    <link rel="stylesheet" href="{asset('static/front/css/front-pages.css')}" />
    {if isset($article['keywords'])}
        <meta name="keywords" content="{$article['keywords']}">
    {/if}
    {if isset($article['description'])}
        <meta name="description" content="{$article['description']}">
    {/if}
{/block}

{block content}
<!-- Banner -->
<div class="Banner_dy">
    {var $bannerUrl = isset($category) ? category_banner($category['id'], asset('static/picture/20210322110902915.jpg')) : asset('static/picture/20210322110902915.jpg')}
    <span style="background-image:url({$bannerUrl})"></span>
    <img src="{$bannerUrl}" alt="">
</div>
<!-- Banner End -->

<nav class="crumbs" aria-label="breadcrumb">
    <div class="auto auto_1150" itemscope itemtype="http://schema.org/BreadcrumbList">
        <em>您的当前位置：</em>
        {ifset $breadcrumbs}
            {foreach $breadcrumbs as $crumb}
                <span itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                    <a itemprop="item" href="{$crumb['url']}">
                        <span itemprop="name">{$crumb['title']}</span>
                    </a>
                    <meta itemprop="position" content="{$iterator->counter}">
                </span>
                {if !$iterator->last}&nbsp;&gt;&nbsp;{/if}
            {/foreach}
            &nbsp;&gt;&nbsp;
            <span itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                <span itemprop="name">{$article['title']}</span>
                <meta itemprop="position" content="{count($breadcrumbs) + 1}">
            </span>
        {/ifset}
    </div>
</nav>

<div class="auto auto_1150 content-wrap">
    <div class="w22 fl"> 
        {include 'sidebar.latte'}
    </div>
    <div class="w75 fr"> 
        <!--Artinfo star-->
        <div class="Artinfo">
            <div class="auto auto_1150">
                <article class="news-details auto w_96 doctor-card" id="print-area">
                    <div class="doctor-tools">
                        <a class="a-print action-link" href="javascript:void(0);">打印</a>
                        <a class="action-link" id="btn-doctor-close" href="javascript:void(0);">关闭</a>
                    </div>
                    <!-- 专家介绍开始 -->
                    <div class="Doctor_info edit-info">
                        <div class="auto">
                            <div class="txt-list">
                                <div class="box">
                                    <div class="ytable">
                                        <div class="ytable-cell pic">
                                            <img width="200px" src="{$article['cover_img'] ?? $article['pic'] ?? asset('static/picture/default-doctor.jpg')}">
                                        </div>
                                        <div class="ytable-cell info">
                                            <div class="content">
                                                <b class="yname">{$article['title']}</b><br>
                                                <b>科室：</b>
                                                {if isset($article['keshi']) && is_array($article['keshi'])}
                                                    {foreach $article['keshi'] as $dept}
                                                        {if is_array($dept) && isset($dept[2])}
                                                            {$dept[2]}<br>
                                                        {/if}
                                                    {/foreach}
                                                {elseif isset($article['keshi'])}
                                                    {$article['keshi']}<br>
                                                {else}
                                                    暂无科室信息<br>
                                                {/if}
                                                <b>职称：</b>
                                                {var $title = isset($article['zhicheng']) ? $article['zhicheng'] : (isset($article['title_other']) ? $article['title_other'] : null)}
                                                {if $title}
                                                    {$title}<br>
                                                {else}
                                                    暂无职称信息<br>
                                                {/if}
                                                <b>任职职务：</b>
                                                {var $pos = isset($article['position']) ? $article['position'] : (isset($article['zhiwu']) ? $article['zhiwu'] : null)}
                                                {if $pos}
                                                    {$pos}<br>
                                                {else}
                                                    暂无任职职务信息<br>
                                                {/if}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="txt-info">
                                <div class="inner">
                                    <h3>专业擅长</h3>
                                    {if isset($article['summary']) && $article['summary']}
                                        {$article['summary']|noescape}
                                    {else}
                                        暂无专业擅长信息
                                    {/if}
                                    <p></p>
                                    <h3>专家履历</h3>
                                    {if isset($article['content']) && $article['content']}
                                        {$article['content']|noescape}
                                    {else}
                                        暂无专家履历信息
                                    {/if}
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- 专家介绍结束 -->
                    
                    <div class="pn-page">
                        {ifset $prevArticle}
                            <aside class="dot">上一篇:<a href="/article/{$prevArticle['id']}">{$prevArticle['title']}</a></aside>
                        {/ifset}
                        
                        {ifset $nextArticle}
                            <aside class="dot">下一篇:<a href="/article/{$nextArticle['id']}">{$nextArticle['title']}</a></aside>
                        {/ifset}
                    </div>
                </article>
            </div>
        </div>
        <!--Artinfo end--> 
    </div>
    <div class="clear"></div>
</div>

<script nonce="{$csp_nonce}">
function SetFont(size) {
    var divBody = document.getElementById("news_content");
    if(!divBody) {
        return;
    }
    divBody.style.fontSize = size + "px";
    var divChildBody = divBody.childNodes;
    for(var i = 0; i < divChildBody.length; i++) {
        if (divChildBody[i].nodeType==1) {
            divChildBody[i].style.fontSize = size + "px";
        }
    }
}

function closeWindow() {
    window.location.href = '/';
}

document.addEventListener('DOMContentLoaded', function () {
    var printButton = document.querySelector('.a-print');
    if (printButton) {
        printButton.addEventListener('click', function (event) {
            event.preventDefault();
            if (typeof jQuery !== 'undefined' && typeof jQuery.fn.printArea === 'function') {
                jQuery('#print-area').printArea();
                return;
            }
            if (typeof window.print === 'function') {
                window.print();
            }
        });
    }

    var closeButton = document.getElementById('btn-doctor-close');
    if (closeButton) {
        closeButton.addEventListener('click', function (event) {
            event.preventDefault();
            closeWindow();
        });
    }
});
</script>

{/block}
