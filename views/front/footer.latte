{* views/front/footer.latte *}
<div class="site_footer">
    <div class="auto auto_1150">
        <dl>
            <dt><a href="javascript:;">友情链接</a></dt>
            <dd class="clearfix">
                {ifset $friendLinksHtml}
                {$friendLinksHtml|noescape}
                {else}
                    {friendLinks()|noescape}
                {/ifset}
            </dd>
        </dl>

        <div class="footer_layout clearfix">
            <div class="footer_share fr">
                <ul class="footer_share_list clearfix">
                    <ol>
                        <aside>分享关注：</aside>
                        <div class="bshare-custom">
                            <div class="bsPromo bsPromo2"></div>
                            <a title="分享到新浪微博" class="bshare-sinaminiblog"></a>
                            <a title="分享到微信" class="bshare-weixin"></a>
                        </div>
                    </ol>
                    <li><img src="{setting('contact_wechat_qr', '')}"></li>
                </ul>
            </div>

            <div class="footer_copyright fl" style="position:relative;">
                <a class="footer_copyright_link" style="position:absolute;left:0;top:0;width:100px;height:100%;z-index:5;" target="_blank" href="{$orgPlatformUrl ?? '#'}"></a>
                &copy; {=date('Y')} {setting('site_name', '')}
                <a id="icp_record_link" href="//beian.miit.gov.cn" target="_blank">{setting('site_icp', '')}</a>
                <a class="footer_beian" style="color: #bcbec0;" href="{setting('site_beian_url', 'http://www.beian.gov.cn/portal/registerSystemInfo?recordcode=')}{setting('site_beian', '')}">
                    <img src="{asset('static/front/images/gaba.png')}" style="vertical-align: middle; display: inline-block;">{setting('site_beian', '')}
                </a>
                <p>乘车方式：{setting('contact_traffic', '')}</p>
                <p>院址：{setting('contact_address', '')} 邮编:{setting('contact_zip', '')}&emsp;服务热线：{setting('contact_phone', '')}&emsp;举报电话：{setting('contact_report_phone', '')}</p>
            </div>
        </div>
    </div>
</div>

<script nonce="{$csp_nonce}">
    $(function ($) {
        $(window).on("resize", function (e) {
            $(".site_footer .select-group dl").each(function () {
                var a = $(this).find("dt").width(),
                    b = $(this).find("dt").find("a").outerWidth(),
                    c = Math.round(((a - b) / 2) / a * 0.8 * 100) + "%";
                $(this).find("dt").find("span").width(c)
            });
        }).trigger("resize");
    });

    $(".site_footer .select-group dl").each(function () {
        $(this).find("dt").click(function () {
            $(this).next("dd").toggle();
            $(this).parent("dl").toggleClass("on");
        });
        $(this).mouseleave(function () {
            $(this).find("dd").hide();
            $(this).removeClass("on");
        });
    });
</script>

<div class="side_toolbar">
    <button class="side_toolbar_toggle" type="button" aria-label="展开侧边导航"></button>
    <a href="#" class="side_toolbar_wechat">
        官方微信
        <span class="side_toolbar_qr">
            <img src="{setting('contact_wechat_qr', '')}" alt="">
        </span>
    </a>
    <a href="/jiuzhenzhinan/" class="side_toolbar_route">来院路线</a>
    <a href="{setting('contact_online_service', '')}" class="side_toolbar_service">在线客服</a>
    <a href="javascript:void(0);" onclick="$('body,html').animate({ scrollTop: 0 },500);" class="side_toolbar_top"><b>TOP</b>回到顶部</a>
</div>

<script nonce="{$csp_nonce}">
    if ($(window).width() < 769) {
        var asideShow = true;
        $('.side_toolbar_toggle').click(function () {
            $(this).toggleClass('active');
            if (asideShow) {
                $('.side_toolbar').stop().animate({ right: '0' }, 300);
            } else {
                $('.side_toolbar').stop().animate({ right: '-70px' }, 300);
            }
            asideShow = !asideShow
        })
    }
</script>
