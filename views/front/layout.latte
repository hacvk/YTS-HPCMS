<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Cache-Control" content="no-transform" />
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <meta name="applicable-device" content="mobile" />
    <meta name="renderer" content="webkit" />
    <meta name="format-detection" content="telephone=no" />
    <meta content="email=no" name="format-detection" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{$title ?? '默认标题'}</title>
    <meta name="keywords" content="{$keywords ?? ''}"/>
    <meta name="description" content="{$description ?? ''}"/>
    <link rel="canonical" href="{$canonicalUrl ?? $baseUrl ?? $appBaseUrl}" />
    {if isset($ogTags)}
    {$ogTags|noescape}
    {/if}
    {if isset($jsonLdSchema)}
    {$jsonLdSchema|noescape}
    {/if}

    <!-- Styles -->
    <link rel="stylesheet" href="{asset('static/css/fontawesome/all.min.css')}" />
    <link rel="stylesheet" href="{asset('static/front/css/front-core.css')}" />
    <link rel="stylesheet" href="{asset('static/front/css/front-layout.css')}" />
    <link rel="stylesheet" href="{asset('static/front/css/front-widgets.css')}" />
    <link rel="stylesheet" href="{asset('static/front/css/front-pages.css')}" />

    <!-- Scripts -->
    <script nonce="{$csp_nonce}" type="text/javascript" src="{asset('static/front/js/jquery-3.3.1.min.js')}"></script>
    <script nonce="{$csp_nonce}" type="text/javascript" src="{asset('static/front/js/jquery.bxslider.js')}"></script>
    <script nonce="{$csp_nonce}" type="text/javascript" src="{asset('static/front/js/carousel.min.2.3.4.js')}"></script>
    <script nonce="{$csp_nonce}" type="text/javascript" src="{asset('static/front/js/jquery.slick.js')}"></script>
    <script nonce="{$csp_nonce}" type="text/javascript" src="{asset('static/front/js/a.whir.menu.js')}"></script>
    <script nonce="{$csp_nonce}" type="text/javascript" src="{asset('static/front/js/jquery.mcustomscrollbar.concat.min.3.1.13.js')}"></script>
    <script nonce="{$csp_nonce}" type="text/javascript" src="{asset('static/front/js/jquery.SuperSlide.2.1.3.js')}"></script>

    <!--[if lt IE 9]>
    <script nonce="{$csp_nonce}" type="text/javascript" src="{asset('static/front/js/html5shiv.v3.72.min.js')}"></script>
    <![endif]-->

    {block head}{/block}
</head>
<body data-base-path="{$basePath ?? '/'}">

{include 'header.latte'}

<main>
    {block content}
    {/block}
</main>

{include 'footer.latte'}

{block scripts}{/block}

</body>
</html>
