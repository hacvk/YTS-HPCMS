{layout '../layout.latte'}

{block content}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">管理员列表</h2>
        {if $can_save}
            <a href="/admin/admin/edit" class="btn btn-primary">新增管理员</a>
        {/if}
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>用户名</th>
                        <th>姓名</th>
                        <th>邮箱</th>
                        <th>手机</th>
                        <th>角色</th>
                        <th style="width: 100px;">状态</th>
                        <th>最后登录</th>
                        <th style="width: 100px;">登录次数</th>
                        <th style="width: 220px;">操作</th>
                    </tr>
                    </thead>
                    <tbody>
                    {if isset($admins) && count($admins) > 0}
                        {foreach $admins as $a}
                            <tr>
                                <td>{$a['id']}</td>
                                <td><code>{$a['username']}</code></td>
                                <td>{$a['name'] ?? ''}</td>
                                <td>{$a['email'] ?? ''}</td>
                                <td>{$a['phone'] ?? ''}</td>
                                <td>
                                    {if isset($a['roles']) && count($a['roles']) > 0}
                                        {foreach $a['roles'] as $r}
                                            <span class="badge bg-info me-1">{$r['title']}</span>
                                        {/foreach}
                                    {else}
                                        <span class="text-muted">-</span>
                                    {/if}
                                </td>
                                <td>
                                    {if (int)($a['status'] ?? 0) === 1}
                                        <span class="badge bg-success">启用</span>
                                    {else}
                                        <span class="badge bg-secondary">禁用</span>
                                    {/if}
                                </td>
                                <td>
                                    {if $a['last_login_time']}
                                        {$a['last_login_time']}<br>
                                        <small class="text-muted">{$a['last_login_ip'] ?? ''}</small>
                                    {else}
                                        <span class="text-muted">从未登录</span>
                                    {/if}
                                </td>
                                <td>{$a['login_count'] ?? 0}</td>
                                <td>
                                    {if (int)$a['id'] === $user['id']}
                                        <span class="text-muted">当前用户</span>
                                    {else}
                                        {if $can_save}
                                            <a class="btn btn-sm btn-outline-primary" href="/admin/admin/edit?id={$a['id']}">编辑</a>
                                        {/if}
                                        {if $can_delete}
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-id="{$a['id']}" onclick="deleteAdmin(this)">删除</button>
                                        {/if}
                                    {/if}
                                </td>
                            </tr>
                        {/foreach}
                    {else}
                        <tr><td colspan="10" class="text-center text-muted py-4">暂无数据</td></tr>
                    {/if}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
function deleteAdmin(btn) {
    const id = btn.getAttribute('data-id');
    if (!id) return;
    if (!confirm('确定删除该管理员？')) return;

    fetch('/admin/admin/delete', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: new URLSearchParams({
            id: id,
            csrf_token: document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        })
    }).then(r => r.json()).then(res => {
        if (res.code === 0) {
            location.href = res.url || '/admin/admin';
        } else {
            alert(res.message || '删除失败');
        }
    }).catch(() => alert('请求失败'));
}
</script>
{/block}
