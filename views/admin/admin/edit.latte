{layout '../layout.latte'}

{block content}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">{$title}</h2>
        <a href="/admin/admin" class="btn btn-outline-secondary">返回</a>
    </div>

    <form id="adminForm" class="row g-3">
        <input type="hidden" name="csrf_token" value="{$csrf_token|noescape}">
        <input type="hidden" name="id" value="{$admin['id'] ?? 0}">

        <div class="col-md-6">
            <label class="form-label">用户名 <span class="text-danger">*</span></label>
            <input class="form-control" name="username" value="{$admin['username'] ?? ''}" required>
        </div>
        <div class="col-md-6">
            <label class="form-label">密码 {if !isset($admin)}<span class="text-danger">*</span>{else}<small class="text-muted">(留空不修改)</small>{/if}</label>
            <input class="form-control" type="password" name="password" {if !isset($admin)}required{/if}>
        </div>

        <div class="col-md-6">
            <label class="form-label">姓名</label>
            <input class="form-control" name="name" value="{$admin['name'] ?? ''}">
        </div>
        <div class="col-md-6">
            <label class="form-label">邮箱</label>
            <input class="form-control" type="email" name="email" value="{$admin['email'] ?? ''}">
        </div>

        <div class="col-md-6">
            <label class="form-label">手机</label>
            <input class="form-control" name="phone" value="{$admin['phone'] ?? ''}">
        </div>
        <div class="col-md-6">
            <label class="form-label">状态</label>
            <select class="form-select" name="status">
                <option value="1" {if (int)($admin['status'] ?? 1) === 1}selected{/if}>启用</option>
                <option value="0" {if (int)($admin['status'] ?? 1) === 0}selected{/if}>禁用</option>
            </select>
        </div>

        <div class="col-12">
            <label class="form-label">角色</label>
            <div class="card">
                <div class="card-body">
                    {if isset($roles) && count($roles) > 0}
                        <div class="row">
                            {foreach $roles as $r}
                                <div class="col-md-4 col-lg-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="role_ids[]" value="{$r['id']}" id="role_{$r['id']}"
                                            {if in_array($r['id'], $selected_role_ids)}checked{/if}>
                                        <label class="form-check-label" for="role_{$r['id']}">
                                            {$r['title']}
                                            {if (int)$r['id'] === 1}
                                                <span class="badge bg-warning text-dark ms-1">系统</span>
                                            {/if}
                                        </label>
                                    </div>
                                </div>
                            {/foreach}
                        </div>
                    {else}
                        <div class="text-muted">暂无角色</div>
                    {/if}
                </div>
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">保存</button>
        </div>
    </form>
</div>

<script>
document.getElementById('adminForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const form = e.target;
    const data = new URLSearchParams(new FormData(form));

    fetch('/admin/admin/save', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: data
    }).then(r => r.json()).then(res => {
        if (res.code === 0) {
            location.href = res.url || '/admin/admin';
        } else {
            alert(res.message || '保存失败');
        }
    }).catch(() => alert('请求失败'));
});
</script>
{/block}
