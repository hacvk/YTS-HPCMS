{extends '../layout.latte'}

{block title}{$title}{/block}

{block content}
<div class="container-fluid">
    <!-- 页面顶部标题 -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">{$title}</h1>
    </div>

    <!-- 日期筛选 -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <form class="form-inline" method="get" action="/admin/visitor/stats">
                <div class="row w-100">
                    <div class="col-md-2 mb-2">
                        <input type="date" class="form-control" id="date" name="date" value="{$date}" placeholder="查询日期">
                    </div>
                    <div class="col-md-2 mb-2">
                        <input type="date" class="form-control" id="start_date" name="start_date" value="{$startDate}" placeholder="开始日期">
                    </div>
                    <div class="col-md-2 mb-2">
                        <input type="date" class="form-control" id="end_date" name="end_date" value="{$endDate}" placeholder="结束日期">
                    </div>
                    <div class="col-md-2 mb-2">
                        <div class="btn-group w-100">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> 查询
                            </button>
                        </div>
                    </div>
                    <div class="col-md-2 mb-2">
                        <div class="btn-group w-100">
                            <a class="btn btn-outline-primary" href="/admin/visitor/stats?date={$date}&start_date={$startDate}&end_date={$endDate}&export=daily">导出日统计</a>
                            <a class="btn btn-outline-secondary" href="/admin/visitor/stats?date={$date}&start_date={$startDate}&end_date={$endDate}&export=range">导出范围</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 每日统计 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">每日统计 ({$date})</h6>
            <div class="btn-group" role="group">
                <a href="/admin/visitor/logs" class="btn btn-primary btn-sm">
                    <i class="fas fa-list"></i> 日志列表
                </a>
                <a href="/admin/visitor/stats" class="btn btn-success btn-sm">
                    <i class="fas fa-chart-bar"></i> 统计
                </a>
                <a href="/admin/visitor/alerts" class="btn btn-warning btn-sm">
                    <i class="fas fa-exclamation-triangle"></i> 告警
                </a>
                <a href="/admin/visitor/anomaly-report" class="btn btn-info btn-sm">
                    <i class="fas fa-file-alt"></i> 检测报告
                </a>
            </div>
        </div>
        <div class="card-body">
            {if $dailyStats}
            <div class="row">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">PV (页面浏览量)</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['pv']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-eye fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">UV (独立访客)</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['uv']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-users fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">IP数</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['ip_count']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-network-wired fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">新访客</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['new_visitor']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-user-plus fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {ifset $dailyStats['session_count']}
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">会话数</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['session_count']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-stream fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {/ifset}
            </div>

            <div class="row">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-secondary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">老访客</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['old_visitor']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-user-check fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-danger shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">错误数</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['error_count']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-dark shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-dark text-uppercase mb-1">爬虫数</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['bot_count']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-spider fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">跳出率</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['bounce_rate']}%</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-door-open fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">平均停留时长</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$dailyStats['avg_duration']}s</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-clock fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {else}
            <div class="alert alert-info" role="alert">
                暂无统计数据，请先运行聚合命令：php artisan visitor:aggregate --date={$date}
            </div>
            {/if}
        </div>
    </div>

    <!-- 时间范围统计 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">时间范围统计 ({$startDate} 至 {$endDate})</h6>
        </div>
        <div class="card-body">
            {if $rangeStats['daily']}
            <div class="row">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">总PV</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$rangeStats['total']['pv']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-eye fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">总UV</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$rangeStats['total']['uv']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-users fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">总IP数</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$rangeStats['total']['ip_count']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-network-wired fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">总新访客</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$rangeStats['total']['new_visitor']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-user-plus fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-secondary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">总老访客</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$rangeStats['total']['old_visitor']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-user-check fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">平均跳出率</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$rangeStats['total']['bounce_rate']|number:2}%</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-door-open fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">平均停留时长</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$rangeStats['total']['avg_duration']|number:2}s</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-clock fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 每日趋势表格 -->
            <div class="table-responsive mt-4">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>PV</th>
                            <th>UV</th>
                            <th>IP数</th>
                            <th>新访客</th>
                            <th>老访客</th>
                            <th>跳出率(%)</th>
                            <th>平均停留(s)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach $rangeStats['daily'] as $stat}
                        <tr>
                            <td>{$stat['date']}</td>
                            <td>{$stat['pv']}</td>
                            <td>{$stat['uv']}</td>
                            <td>{$stat['ip_count']}</td>
                            <td>{$stat['new_visitor']}</td>
                            <td>{$stat['old_visitor']}</td>
                            <td>{$stat['bounce_rate']|number:2}</td>
                            <td>{$stat['avg_duration']|number:2}</td>
                        </tr>
                        {/foreach}
                    </tbody>
                </table>
            </div>
            {else}
            <div class="alert alert-info" role="alert">
                暂无统计数据，请先运行聚合命令：php artisan visitor:aggregate --date={$startDate}
            </div>
            {/if}
        </div>
    </div>

    <!-- 实时统计 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">实时统计 (最近24小时)</h6>
        </div>
        <div class="card-body">
            {if $realTimeStats}
            <div class="row">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">PV</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$realTimeStats['pv']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-eye fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">UV</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{$realTimeStats['uv']}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-users fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 按小时统计表格 -->
            <div class="table-responsive mt-4">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>小时</th>
                            <th>请求数</th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach $realTimeStats['hourly'] as $stat}
                        <tr>
                            <td>{$stat['hour']}</td>
                            <td>{$stat['count']}</td>
                        </tr>
                        {/foreach}
                    </tbody>
                </table>
            </div>
            {else}
            <div class="alert alert-info" role="alert">
                暂无实时统计数据
            </div>
            {/if}
        </div>
    </div>

    <!-- 异常统计 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">异常统计 ({$date})</h6>
        </div>
        <div class="card-body">
            {if $anomalyStats}
            <!-- 错误请求统计 -->
            {if $anomalyStats['error_stats']}
            <div class="table-responsive mb-4">
                <h6 class="font-weight-bold text-danger">错误请求统计</h6>
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>状态码</th>
                            <th>数量</th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach $anomalyStats['error_stats'] as $stat}
                        <tr>
                            <td>{$stat['status_code']}</td>
                            <td>{$stat['count']}</td>
                        </tr>
                        {/foreach}
                    </tbody>
                </table>
            </div>
            {/if}

            <!-- 爬虫统计 -->
            {if $anomalyStats['bot_stats']}
            <div class="table-responsive mb-4">
                <h6 class="font-weight-bold text-warning">爬虫统计</h6>
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>User-Agent</th>
                            <th>数量</th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach $anomalyStats['bot_stats'] as $stat}
                        <tr>
                            <td style="word-break: break-word; max-width: 300px;">{$stat['user_agent']}</td>
                            <td>{$stat['count']}</td>
                        </tr>
                        {/foreach}
                    </tbody>
                </table>
            </div>
            {/if}

            <!-- 高频访问IP -->
            {if $anomalyStats['high_frequency_ips']}
            <div class="table-responsive">
                <h6 class="font-weight-bold text-danger">高频访问IP (≥100次)</h6>
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>IP地址</th>
                            <th>请求数</th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach $anomalyStats['high_frequency_ips'] as $stat}
                        <tr>
                            <td>{$stat['ip']}</td>
                            <td>{$stat['count']}</td>
                        </tr>
                        {/foreach}
                    </tbody>
                </table>
            </div>
            {/if}
            {else}
            <div class="alert alert-info" role="alert">
                暂无异常统计数据
            </div>
            {/if}
        </div>
    </div>
</div>
{/block}
