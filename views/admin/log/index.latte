{extends '../layout.latte'}

{block title}{$title}{/block}

{block content}
<div class="container-fluid">
    <!-- 页面顶部标题 -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">{$title}</h1>
    </div>
    
    <!-- 筛选搜索框 -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <form class="form-inline" method="get" action="/admin/log">
                <div class="form-group mr-3 mb-2">
                    <label for="action" class="mr-2">操作类型：</label>
                    <select class="form-control" id="action" name="action">
                        <option value="">全部</option>
                        {foreach $action_types as $key => $label}
                        <option value="{$key}" {if $action == $key}selected{/if}>{$label}</option>
                        {/foreach}
                    </select>
                </div>
                
                <div class="form-group mr-3 mb-2">
                    <label for="start_date" class="mr-2">开始日期：</label>
                    <input type="date" class="form-control" id="start_date" name="start_date" value="{$start_date}">
                </div>
                
                <div class="form-group mr-3 mb-2">
                    <label for="end_date" class="mr-2">结束日期：</label>
                    <input type="date" class="form-control" id="end_date" name="end_date" value="{$end_date}">
                </div>
                
                <button type="submit" class="btn btn-primary mb-2">
                    <i class="fas fa-search"></i> 搜索
                </button>
                <a href="/admin/log" class="btn btn-secondary mb-2 ml-2">
                    <i class="fas fa-redo"></i> 重置
                </a>
            </form>
        </div>
    </div>
    
    <!-- 日志列表表格 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">日志列表</h6>
            <button type="button" class="btn btn-sm btn-danger" onclick="cleanLogs()">
                <i class="fas fa-trash"></i> 清理过期日志
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="min-width: 80px; width: 80px;">ID</th>
                            <th style="min-width: 120px; width: 120px;">管理员</th>
                            <th style="min-width: 100px; width: 100px;">操作类型</th>
                            <th style="min-width: 200px;">操作内容</th>
                            <th style="min-width: 150px;">目标</th>
                            <th style="min-width: 130px; width: 130px;">IP地址</th>
                            <th style="min-width: 160px; width: 160px;">时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        {if count($logs) > 0}
                        {foreach $logs as $log}
                        <tr>
                            <td style="word-break: break-word; white-space: nowrap;">{$log['id']}</td>
                            <td style="word-break: break-word; white-space: nowrap;">{$log['admin_name']}</td>
                            <td style="word-break: break-word; white-space: nowrap;">
                                {if $log['action'] == 'login'}
                                <span class="badge badge-pill bg-success">登录</span>
                                {elseif $log['action'] == 'logout'}
                                <span class="badge badge-pill bg-dark text-white">退出</span>
                                {elseif $log['action'] == 'create'}
                                <span class="badge badge-pill bg-primary">创建</span>
                                {elseif $log['action'] == 'update'}
                                <span class="badge badge-pill bg-info text-dark">更新</span>
                                {elseif $log['action'] == 'delete'}
                                <span class="badge badge-pill bg-danger">删除</span>
                                {elseif $log['action'] == 'error'}
                                <span class="badge badge-pill bg-warning text-dark">错误</span>
                                {elseif $log['action'] === '' || $log['action'] === null}
                                <span class="badge badge-pill bg-light text-dark">未知</span>
                                {else}
                                <span class="badge badge-pill bg-secondary">{$log['action']}</span>
                                {/if}
                            </td>
                            <td style="word-break: break-word; max-width: 200px;">
                                <div style="overflow: hidden; text-overflow: ellipsis; white-space: normal; max-height: 3em; line-height: 1.5em;">
                                    {$log['message']}
                                </div>
                            </td>
                            <td style="word-break: break-word; max-width: 150px;">
                                <div style="overflow: hidden; text-overflow: ellipsis; white-space: normal;">
                                    {if isset($log['target']) && $log['target']}{$log['target']}{else}-{/if}
                                </div>
                            </td>
                            <td style="word-break: break-word; white-space: nowrap;">{$log['ip']}</td>
                            <td style="word-break: break-word; white-space: nowrap;">{$log['create_time']}</td>
                        </tr>
                        {/foreach}
                        {else}
                        <tr>
                            <td colspan="7" class="text-center">暂无数据</td>
                        </tr>
                        {/if}
                    </tbody>
                </table>
            </div>
            
            <!-- 分页 -->
            {if $total > 0}
            <div class="pagination justify-content-center mt-4">
                <ul class="pagination">
                    <li class="page-item {if $page == 1}disabled{/if}">
                        <a class="page-link" href="/admin/log?page={$page-1}&action={$action}&start_date={$start_date}&end_date={$end_date}" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    
                    {var $totalPages = ceil($total / $limit)}
                    {var $startPage = max(1, $page - 4)}
                    {var $endPage = min($totalPages, $startPage + 8)} 
                    {if $startPage > 1}
                    <li class="page-item"><a class="page-link" href="/admin/log?page=1&action={$action}&start_date={$start_date}&end_date={$end_date}">1</a></li>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                    {/if}
                    
                    {for $i = $startPage; $i <= $endPage; $i++}
                    <li class="page-item {if $i == $page}active{/if}">
                        <a class="page-link" href="/admin/log?page={$i}&action={$action}&start_date={$start_date}&end_date={$end_date}">{$i}</a>
                    </li>
                    {/for}
                    
                    {if $endPage < $totalPages}
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                    <li class="page-item"><a class="page-link" href="/admin/log?page={$totalPages}&action={$action}&start_date={$start_date}&end_date={$end_date}">{$totalPages}</a></li>
                    {/if}
                    
                    <li class="page-item {if $page == $totalPages}disabled{/if}">
                        <a class="page-link" href="/admin/log?page={$page+1}&action={$action}&start_date={$start_date}&end_date={$end_date}" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </div>
            {/if}
        </div>
    </div>
</div>

<!-- 清理日志确认对话框 -->
<script n:syntax=off>
function cleanLogs() {
    const days = prompt('请输入要保留的天数（默认30天）：', '30');
    if (days === null) return;
    
    const daysNum = parseInt(days);
    if (isNaN(daysNum) || daysNum < 1) {
        alert('请输入有效的天数');
        return;
    }
    
    if (!confirm('确定要清理 ' + daysNum + ' 天前的日志吗？此操作不可恢复！')) {
        return;
    }
    
    // 获取 CSRF Token
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || 
                     document.getElementById('csrf_token')?.value || '';
    
    // 发送清理请求
    fetch('/admin/log/clean', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'csrf_token=' + encodeURIComponent(csrfToken) + '&days=' + daysNum
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
        if (data.code === 0) {
            alert(data.message);
            window.location.reload();
        } else {
            alert(data.message || '清理失败');
        }
    })
    .catch(function(error) {
        console.error('清理失败:', error);
        alert('清理失败：' + error.message);
    });
}
</script>
{/block}
