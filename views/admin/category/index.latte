{extends "../layout.latte"}

{block content}
<div class="container-fluid">
    <!-- 操作栏 -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">栏目列表</h5>
                <a href="/admin/category/add" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> 添加栏目
                </a>
            </div>
        </div>
    </div>

    <!-- 栏目列表 -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">ID</th>
                            <th>栏目名称</th>
                            <th style="width: 120px;">别名</th>
                            <th style="width: 100px;">类型</th>
                            <th style="width: 80px;">排序</th>
                            <th style="width: 80px;">状态</th>
                            <th style="width: 150px;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        {if count($categories) > 0}
                            {include '../category-tree.latte', categories => $categories, level => 0}
                        {else}
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>
                                    <p class="text-muted mt-2">暂无栏目数据</p>
                                    <a href="/admin/category/add" class="btn btn-primary btn-sm">
                                        添加第一个栏目
                                    </a>
                                </td>
                            </tr>
                        {/if}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
.tree-toggle {
    cursor: pointer;
    margin-right: 0.5rem;
    color: #6c757d;
}

.tree-toggle:hover {
    color: #4e73df;
}

.hidden-row {
    display: none;
}
</style>

<script nonce="{$csp_nonce}">
// 树形折叠/展开
function toggleTree(id) {
    var rows = document.querySelectorAll('[data-parent="' + id + '"]');
    rows.forEach(function(row) {
        if (row.classList.contains('hidden-row')) {
            row.classList.remove('hidden-row');
        } else {
            row.classList.add('hidden-row');
        }
    });
}

// 删除栏目
function deleteCategory(id, name) {
    if (!confirm('确定要删除栏目 "' + name + '" 吗？\n\n注意：如果有子栏目或文章将无法删除。')) {
        return;
    }

    // 获取 CSRF Token
    var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

    fetch('/admin/category/delete', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'id=' + id + '&csrf_token=' + encodeURIComponent(csrfToken)
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
        if (data.code === 0) {
            alert(data.message);
            window.location.href = '/admin/category';
        } else {
            alert(data.message);
        }
    })
    .catch(function(error) {
        alert('删除失败：' + error.message);
    });
}
</script>
{/block}
