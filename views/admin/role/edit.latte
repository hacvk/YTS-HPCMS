{layout '../layout.latte'}

{block content}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">{$title}</h2>
        <a href="/admin/role" class="btn btn-outline-secondary">返回</a>
    </div>

    <form id="roleForm" class="row g-3">
        <input type="hidden" name="csrf_token" value="{$csrf_token|noescape}">
        <input type="hidden" name="id" value="{$role['id'] ?? 0}">

        <div class="col-md-4">
            <label class="form-label">角色标识</label>
            <input class="form-control" name="name" value="{$role['name'] ?? ''}" required>
        </div>
        <div class="col-md-4">
            <label class="form-label">角色名称</label>
            <input class="form-control" name="title" value="{$role['title'] ?? ''}">
        </div>
        <div class="col-md-2">
            <label class="form-label">状态</label>
            <select class="form-select" name="status">
                <option value="1" {if (int)($role['status'] ?? 1) === 1}selected{/if}>启用</option>
                <option value="0" {if (int)($role['status'] ?? 1) === 0}selected{/if}>禁用</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">排序</label>
            <input class="form-control" type="number" name="sort" value="{$role['sort'] ?? 0}">
        </div>

        <div class="col-12">
            <label class="form-label">备注</label>
            <input class="form-control" name="remark" value="{$role['remark'] ?? ''}">
        </div>

        <div class="col-12">
            <label class="form-label">权限</label>
            <div class="card">
                <div class="card-body">
                    {if isset($perm_groups) && count($perm_groups) > 0}
                        {foreach $perm_groups as $gName => $items}
                            <div class="mb-3">
                                <div class="fw-semibold mb-2">{$gName}</div>
                                <div class="row">
                                    {foreach $items as $p}
                                        <div class="col-md-4 col-lg-3">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="perm_keys[]" value="{$p['key']}" id="perm_{$p['key']|replace:':','_'}"
                                                    {if in_array($p['key'], $selected_perm_keys)}checked{/if}>
                                                <label class="form-check-label" for="perm_{$p['key']|replace:':','_'}">{$p['title']}</label>
                                            </div>
                                        </div>
                                    {/foreach}
                                </div>
                            </div>
                        {/foreach}
                    {else}
                        <div class="text-muted">暂无权限项</div>
                    {/if}
                </div>
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">保存</button>
        </div>
    </form>
</div>

<script>
document.getElementById('roleForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const form = e.target;
    const data = new URLSearchParams(new FormData(form));

    fetch('/admin/role/save', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: data
    }).then(r => r.json()).then(res => {
        if (res.code === 0) {
            location.href = res.url || '/admin/role';
        } else {
            alert(res.message || '保存失败');
        }
    }).catch(() => alert('请求失败'));
});
</script>
{/block}
