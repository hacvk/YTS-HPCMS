{layout '../layout.latte'}

{block content}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">角色列表</h2>
        {if $can_save}
            <a href="/admin/role/edit" class="btn btn-primary">新增角色</a>
        {/if}
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>标识</th>
                        <th>名称</th>
                        <th style="width: 100px;">状态</th>
                        <th style="width: 100px;">排序</th>
                        <th>备注</th>
                        <th style="width: 180px;">更新时间</th>
                        <th style="width: 220px;">操作</th>
                    </tr>
                    </thead>
                    <tbody>
                    {if isset($roles) && count($roles) > 0}
                        {foreach $roles as $r}
                            <tr>
                                <td>{$r['id']}</td>
                                <td><code>{$r['name']}</code></td>
                                <td>{$r['title'] ?? ''}</td>
                                <td>
                                    {if (int)($r['status'] ?? 0) === 1}
                                        <span class="badge bg-success">启用</span>
                                    {else}
                                        <span class="badge bg-secondary">禁用</span>
                                    {/if}
                                </td>
                                <td>{$r['sort'] ?? 0}</td>
                                <td>{$r['remark'] ?? ''}</td>
                                <td>{$r['updated_at'] ?? ''}</td>
                                <td>
                                    {if (int)$r['id'] === 1}
                                        <span class="text-muted">系统内置</span>
                                    {else}
                                        {if $can_save}
                                            <a class="btn btn-sm btn-outline-primary" href="/admin/role/edit?id={$r['id']}">编辑</a>
                                        {/if}
                                        {if $can_delete}
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-id="{$r['id']}" onclick="deleteRole(this)">删除</button>
                                        {/if}
                                    {/if}
                                </td>
                            </tr>
                        {/foreach}
                    {else}
                        <tr><td colspan="8" class="text-center text-muted py-4">暂无数据</td></tr>
                    {/if}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script nonce="{$csp_nonce}">
function deleteRole(btn) {
    const id = btn.getAttribute('data-id');
    if (!id) return;
    if (!confirm('确定删除该角色？')) return;

    fetch('/admin/role/delete', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: new URLSearchParams({
            id: id,
            csrf_token: document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        })
    }).then(r => r.json()).then(res => {
        if (res.code === 0) {
            location.href = res.url || '/admin/role';
        } else {
            alert(res.message || '删除失败');
        }
    }).catch(() => alert('请求失败'));
}
</script>
{/block}
