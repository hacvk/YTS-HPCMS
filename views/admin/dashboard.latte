{extends "layout.latte"}

{block content}
    <div class="container-fluid">
        <!-- 欢迎语 -->
        <div class="alert alert-info mb-4">
            <i class="bi bi-info-circle"></i>
            欢迎回来，<strong>{$user['name'] ?? '管理员'}</strong>！今天是 {date('Y年m月d日')}，祝您工作愉快。
        </div>

        {if isset($error)}
            <div class="alert alert-danger mb-4">
                <i class="bi bi-exclamation-triangle"></i>
                数据加载失败：{$error}
            </div>
        {/if}

        <!-- 统计卡片 -->
        <div class="row mb-4">
            <!-- 文章总数 -->
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary mb-1">
                                    文章总数
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    {$stats['articles'] ?? 0}
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-file-earmark-text fa-2x text-gray-300" style="font-size: 3rem; color: #4e73df;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 栏目总数 -->
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success mb-1">
                                    栏目总数
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    {$stats['categories'] ?? 0}
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-folder fa-2x text-gray-300" style="font-size: 3rem; color: #1cc88a;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 今日登录 -->
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info mb-1">
                                    今日登录
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    {$stats['today_logins'] ?? 0}
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-people fa-2x text-gray-300" style="font-size: 3rem; color: #36b9cc;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 系统运行 -->
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-warning shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning mb-1">
                                    系统运行
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    {$stats['system_days'] ?? 0} 天
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-clock fa-2x text-gray-300" style="font-size: 3rem; color: #f6c23e;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 详细信息 -->
        <div class="row">
            <!-- 用户信息 -->
            <div class="col-lg-6 mb-4">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="bi bi-person"></i> 管理员信息
                        </h6>
                    </div>
                    <div class="card-body">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 30%;">用户名</th>
                                    <td>{$user['username'] ?? '-'}</td>
                                </tr>
                                <tr>
                                    <th>姓名</th>
                                    <td>{$user['name'] ?? '-'}</td>
                                </tr>
                                <tr>
                                    <th>角色</th>
                                    <td>{$user['role_name'] ?? '-'}</td>
                                </tr>
                                <tr>
                                    <th>登录次数</th>
                                    <td>{$stats['login_count'] ?? 0} 次</td>
                                </tr>
                                <tr>
                                    <th>最后登录</th>
                                    <td>{$stats['last_login_time'] ?? '首次登录'}</td>
                                </tr>
                                <tr>
                                    <th>最后登录IP</th>
                                    <td>{$user['last_login_ip'] ?? '-'}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- 系统信息 -->
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="bi bi-info-circle"></i> 系统信息
                        </h6>
                    </div>
                    <div class="card-body">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 30%;">系统名称</th>
                                    <td>{$system_info['name'] ?? 'YTS-HPCMS'}</td>
                                </tr>
                                <tr>
                                    <th>版本号</th>
                                    <td>{$system_info['version'] ?? '1.0.0'}</td>
                                </tr>
                                <tr>
                                    <th>发布日期</th>
                                    <td>{$system_info['release_date'] ?? '2024-07-30'}</td>
                                </tr>
                                <tr>
                                    <th>开发者</th>
                                    <td>
                                        <a href="{$system_info['developer_url'] ?? 'https://lingxian.tech'}" target="_blank">{$system_info['developer'] ?? '研昌技服'}</a>
                                    </td>
                                </tr>
                                <tr>
                                    <th>版权信息</th>
                                    <td>{=str_replace('{year}', date('Y'), $system_info['copyright'] ?? '© {year} Yanchang Tech-Service. All rights reserved.')}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 最近日志 -->
            <div class="col-lg-6 mb-4">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="bi bi-clock-history"></i> 最近日志
                        </h6>
                        <div class="d-flex gap-2">
                            <a href="/admin/system/logs?type=system" class="btn btn-sm btn-outline-primary">系统日志</a>
                            <a href="/admin/system/logs?type=operation" class="btn btn-sm btn-outline-primary">操作日志</a>
                            <a href="/admin/visitor/logs" class="btn btn-sm btn-outline-primary">访问日志</a>
                        </div>
                    </div>
                    <div class="card-body">
                        {if count($recent_logs) > 0}
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>管理员</th>
                                            <th>操作</th>
                                            <th>时间</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {foreach $recent_logs as $log}
                                            <tr>
                                                <td>{$log['admin_name'] ?? '-'}</td>
                                                <td>{$log['message'] ?? '-'}</td>
                                                <td>
                                                    <small class="text-muted">
                                                        {$log['create_time'] ?? '-'}
                                                    </small>
                                                </td>
                                            </tr>
                                        {/foreach}
                                    </tbody>
                                </table>
                            </div>
                        {else}
                            <p class="text-muted text-center py-4">暂无日志记录</p>
                        {/if}
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="bi bi-shield-exclamation"></i> 关站维护
                </h6>
                <span class="badge {if $maintenance['enabled']}bg-danger{else}bg-success{/if}">
                    {if $maintenance['enabled']}已开启{else}已关闭{/if}
                </span>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    启用后，前台将显示维护提示页面。后台不受影响。
                    {if $maintenance['updated_at']}<span class="ms-2">最近更新：{$maintenance['updated_at']}</span>{/if}
                </p>
                <div class="mb-3">
                    <label class="form-label">维护提示文案</label>
                    <textarea id="maintenance-message" class="form-control" rows="3">{$maintenance['message']}</textarea>
                </div>
                <button id="btn-maintenance-toggle" class="btn {if $maintenance['enabled']}btn-success{else}btn-danger{/if}">
                    {if $maintenance['enabled']}取消关站{else}开启关站{/if}
                </button>
            </div>
        </div>
    </div>

    <script nonce="{$csp_nonce}">
    document.addEventListener('DOMContentLoaded', function () {
        var toggleButton = document.getElementById('btn-maintenance-toggle');
        if (!toggleButton) {
            return;
        }
        toggleButton.addEventListener('click', function () {
            var isEnabled = toggleButton.classList.contains('btn-success');
            var targetEnabled = isEnabled ? '0' : '1';
            var firstConfirm = confirm(isEnabled ? '确定要关闭关站维护吗？' : '确定要开启关站维护吗？');
            if (!firstConfirm) {
                return;
            }
            var secondConfirm = confirm('请再次确认，此操作将影响前台访问。');
            if (!secondConfirm) {
                return;
            }

            var messageInput = document.getElementById('maintenance-message');
            var message = messageInput ? messageInput.value : '';
            var tokenMeta = document.querySelector('meta[name="csrf-token"]');
            var csrfToken = tokenMeta ? tokenMeta.content : '';

            fetch('/admin/dashboard/maintenance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: 'csrf_token=' + encodeURIComponent(csrfToken) + '&enabled=' + encodeURIComponent(targetEnabled) + '&message=' + encodeURIComponent(message)
            })
            .then(function (response) {
                return response.json();
            })
            .then(function (data) {
                if (data.code === 0) {
                    window.location.reload();
                    return;
                }
                alert(data.message || '操作失败');
            })
            .catch(function () {
                alert('操作失败，请稍后重试');
            });
        });
    });
    </script>

    <style>
        .card {
            border: none;
            border-radius: 0.5rem;
        }
        
        .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
        }
        
        .border-left-primary {
            border-left: 0.25rem solid #4e73df !important;
        }
        
        .border-left-success {
            border-left: 0.25rem solid #1cc88a !important;
        }
        
        .border-left-info {
            border-left: 0.25rem solid #36b9cc !important;
        }
        
        .border-left-warning {
            border-left: 0.25rem solid #f6c23e !important;
        }
    </style>
{/block}
