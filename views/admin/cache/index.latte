{extends "../layout.latte"}

{block content}
<div class="container-fluid">
    <!-- 缓存统计 -->
    <div class="row mb-4">
        <div class="col-md-3 col-xl-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Latte 模板缓存
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {$latte_file_count} 个文件
                            </div>
                            <div class="text-xs text-gray-500 mt-1">
                                总大小: {$latte_total_size_formatted}
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-file-code fa-2x text-gray-300" style="font-size: 2.5rem; color: #4e73df;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-xl-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                缓存目录
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                cache/
                            </div>
                            <div class="text-xs text-gray-500 mt-1">
                                所有缓存文件存放位置
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-folder2-open fa-2x text-gray-300" style="font-size: 2.5rem; color: #1cc88a;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-xl-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                应用缓存
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {$app_cache_file_count} 个文件
                            </div>
                            <div class="text-xs text-gray-500 mt-1">
                                总大小: {$app_cache_total_size_formatted}
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-lightning-charge fa-2x text-gray-300" style="font-size: 2.5rem; color: #36b9cc;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-xl-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                操作
                            </div>
                            <div class="text-xs text-gray-500 mt-1">
                                缓存清理与刷新
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-gear fa-2x text-gray-300" style="font-size: 2.5rem; color: #36b9cc;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                操作
                            </div>
                            <div class="mt-3">
                                <button id="btn-clear-latte" class="btn btn-sm btn-primary me-2">
                                    <i class="bi bi-trash"></i> 清空 Latte 缓存
                                </button>
                                <button id="btn-clear-app" class="btn btn-sm btn-info me-2">
                                    <i class="bi bi-lightning-charge"></i> 清空应用缓存
                                </button>
                                <button id="btn-clear-search" class="btn btn-sm btn-info me-2">
                                    <i class="bi bi-search"></i> 清空搜索缓存
                                </button>
                                <button id="btn-clear-all" class="btn btn-sm btn-danger me-2">
                                    <i class="bi bi-trash3"></i> 清空所有缓存
                                </button>
                                <button id="btn-refresh" class="btn btn-sm btn-secondary">
                                    <i class="bi bi-arrow-repeat"></i> 刷新页面
                                </button>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-gear fa-2x text-gray-300" style="font-size: 2.5rem; color: #36b9cc;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 缓存文件列表 -->
    <div class="card mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="bi bi-file-earmark-code"></i> Latte 模板缓存文件
            </h6>
        </div>
        <div class="card-body">
            {if count($latte_files) > 0}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>文件名</th>
                                <th style="width: 150px;">大小</th>
                                <th style="width: 200px;">修改时间</th>
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $latte_files as $file}
                                <tr>
                                    <td>
                                        <code>{$file['name']}</code>
                                    </td>
                                    <td>{$file['size_formatted']}</td>
                                    <td class="text-muted small">
                                        {$file['modified_formatted']}
                                    </td>
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
                {if $latte_file_count > $latte_display_limit}
                    <div class="text-muted small mt-2">
                        仅显示最近 {$latte_display_limit} 个缓存文件（总计 {$latte_file_count} 个）
                    </div>
                {/if}
            {else}
                <div class="text-center py-5">
                    <i class="bi bi-check-circle" style="font-size: 3rem; color: #1cc88a;"></i>
                    <p class="text-muted mt-3">当前没有缓存文件</p>
                </div>
            {/if}
        </div>
    </div>
</div>

<style>
.border-left-primary {
    border-left: 0.25rem solid #4e73df !important;
}

.border-left-success {
    border-left: 0.25rem solid #1cc88a !important;
}

.border-left-info {
    border-left: 0.25rem solid #36b9cc !important;
}

.text-xs {
    font-size: 0.7rem;
}

.font-weight-bold {
    font-weight: 700;
}

.text-primary {
    color: #4e73df !important;
}

.text-success {
    color: #1cc88a !important;
}

.text-info {
    color: #36b9cc !important;
}

.text-gray-800 {
    color: #5a5c69 !important;
}

.text-gray-500 {
    color: #858796 !important;
}
</style>

<script nonce="{$csp_nonce}">
document.addEventListener('DOMContentLoaded', function () {
    const bind = function (id, handler) {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('click', handler);
        }
    };

    bind('btn-clear-latte', clearLatteCache);
    bind('btn-clear-app', clearAppCache);
    bind('btn-clear-search', clearSearchCache);
    bind('btn-clear-all', clearAllCache);
    bind('btn-refresh', refreshPage);
});

// 清空 Latte 缓存
function clearLatteCache() {
    if (!confirm('确定要清空 Latte 模板缓存吗？\n\n这将删除所有编译后的模板文件。')) {
        return;
    }

    // 获取 CSRF Token
    var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

    fetch('/admin/cache/clear-latte', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'csrf_token=' + encodeURIComponent(csrfToken)
    })
    .then(function(response) {
        // 检查响应是否为JSON
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            return response.json();
        } else {
            // 如果不是JSON，构造一个错误对象
            throw new Error('服务器返回了意外的响应格式');
        }
    })
    .then(function(data) {
        if (data.code === 0) {
            alert(data.message);
            window.location.href = '/admin/cache';
        } else {
            alert(data.message);
        }
    })
    .catch(function(error) {
        console.error('操作失败:', error);
        alert('操作失败：' + error.message + ' (请检查服务器状态)');
    });
}

// 清空搜索缓存
function clearSearchCache() {
    if (!confirm('确定要清空搜索缓存吗？\n\n这将删除搜索缓存、搜索日志和拦截记录。')) {
        return;
    }

    // 获取 CSRF Token
    var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

    fetch('/admin/cache/clear-search', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'csrf_token=' + encodeURIComponent(csrfToken)
    })
    .then(function(response) {
        // 检查响应是否为JSON
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            return response.json();
        } else {
            // 如果不是JSON，构造一个错误对象
            throw new Error('服务器返回了意外的响应格式');
        }
    })
    .then(function(data) {
        if (data.code === 0) {
            alert(data.message);
            window.location.href = '/admin/cache';
        } else {
            alert(data.message);
        }
    })
    .catch(function(error) {
        console.error('操作失败:', error);
        alert('操作失败：' + error.message + ' (请检查服务器状态)');
    });
}

// 清空应用缓存
function clearAppCache() {
    if (!confirm('确定要清空应用缓存吗？\n\n这将清理 Symfony Cache 存储。')) {
        return;
    }

    // 获取 CSRF Token
    var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

    fetch('/admin/cache/clear-app', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'csrf_token=' + encodeURIComponent(csrfToken)
    })
    .then(function(response) {
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            return response.json();
        }
        throw new Error('服务器返回了意外的响应格式');
    })
    .then(function(data) {
        if (data.code === 0) {
            alert(data.message);
            window.location.href = '/admin/cache';
        } else {
            alert(data.message);
        }
    })
    .catch(function(error) {
        console.error('操作失败:', error);
        alert('操作失败：' + error.message + ' (请检查服务器状态)');
    });
}

// 清空所有缓存
function clearAllCache() {
    if (!confirm('确定要清空所有缓存吗？\n\n这将删除 cache 目录下的所有缓存文件。')) {
        return;
    }

    // 获取 CSRF Token
    var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

    fetch('/admin/cache/clear-all', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'csrf_token=' + encodeURIComponent(csrfToken)
    })
    .then(function(response) {
        // 检查响应是否为JSON
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            return response.json();
        } else {
            // 如果不是JSON，构造一个错误对象
            throw new Error('服务器返回了意外的响应格式');
        }
    })
    .then(function(data) {
        if (data.code === 0) {
            alert(data.message);
            window.location.href = '/admin/cache';
        } else {
            alert(data.message);
        }
    })
    .catch(function(error) {
        console.error('操作失败:', error);
        alert('操作失败：' + error.message + ' (请检查服务器状态)');
    });
}

// 刷新页面
function refreshPage() {
    window.location.reload();
}
</script>
{/block}
