{extends '../layout.latte'}

{block title}{$title}{/block}

{block content}
<div class="container-fluid">
    <!-- 页面顶部标题 -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">{$title}</h1>
    </div>
    
    <!-- 设置表单 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-cog"></i> 系统基本设置
            </h6>
        </div>
        <div class="card-body">
            <form id="settingForm" action="/admin/setting/save" method="post">
                <!-- CSRF Token -->
                <input type="hidden" name="csrf_token" id="csrf_token" value="{$csrf_token}">
                
                {foreach $setting_groups as $groupKey => $group}
                <div class="setting-group mb-4">
                    <h5 class="mb-3 border-bottom pb-2">
                        <i class="fas fa-folder-open"></i> {$group['title']}
                    </h5>
                    
                    {foreach $group['fields'] as $fieldKey => $field}
                    <div class="form-group mb-3">
                        <label for="setting_{$fieldKey}">
                            {$field['label']}
                            {if isset($field['required']) && $field['required']}
                            <span class="text-danger">*</span>
                            {/if}
                        </label>
                        
                        {if $field['type'] == 'textarea'}
                        <textarea 
                            class="form-control" 
                            id="setting_{$fieldKey}" 
                            name="{$fieldKey}" 
                            rows="3"
                            {if isset($field['required']) && $field['required']}required{/if}
                        >{if isset($settings[$fieldKey])}{$settings[$fieldKey]}{/if}</textarea>
                        
                        {elseif $field['type'] == 'image'}
                        <div class="input-group">
                            <input 
                                type="text" 
                                class="form-control" 
                                id="setting_{$fieldKey}" 
                                name="{$fieldKey}" 
                                value="{if isset($settings[$fieldKey])}{$settings[$fieldKey]}{/if}" 
                                placeholder="请输入图片URL"
                            >
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary" onclick="selectImage('setting_{$fieldKey|noescape}')">
                                    <i class="fas fa-image"></i> 选择图片
                                </button>
                            </div>
                        </div>
                        <div class="mt-2" id="preview_{$fieldKey}">
                            {if isset($settings[$fieldKey]) && $settings[$fieldKey]}
                                <img src="{$settings[$fieldKey]}" width="200" class="img-thumbnail" style="margin-bottom: 10px;">
                                <div class="mt-1">
                                    <button type="button" class="btn btn-sm btn-danger" onclick="console.log('按钮被点击'); deleteImage('setting_{$fieldKey|noescape}', 'preview_{$fieldKey|noescape}', '{$fieldKey|noescape}')">
                                        <i class="fas fa-trash"></i> 删除图片
                                    </button>
                                </div>
                            {/if}
                        </div>
                        
                        {elseif $field['type'] == 'email'}
                        <input 
                            type="email" 
                            class="form-control" 
                            id="setting_{$fieldKey}" 
                            name="{$fieldKey}" 
                            value="{if isset($settings[$fieldKey])}{$settings[$fieldKey]}{/if}" 
                            placeholder="请输入{$field['label']}"
                            {if isset($field['required']) && $field['required']}required{/if}
                        >
                        
                        {else}
                        <input 
                            type="text" 
                            class="form-control" 
                            id="setting_{$fieldKey}" 
                            name="{$fieldKey}" 
                            value="{if isset($settings[$fieldKey])}{$settings[$fieldKey]}{/if}" 
                            placeholder="请输入{$field['label']}"
                            {if isset($field['required']) && $field['required']}required{/if}
                        >
                        {/if}
                        
                        {if isset($field['help'])}
                        <small class="form-text text-muted">{$field['help']}</small>
                        {/if}
                    </div>
                    {/foreach}
                </div>
                {/foreach}
                
                <div class="form-group mb-3">
        <label for="setting_site_url">网站 URL</label>
        <input type="text" class="form-control" id="setting_site_url" name="site_url"
               value="{if isset($settings['site_url'])}{$settings['site_url']}{/if}" placeholder="https://www.example.com">
    </div>
    <div class="form-group mb-3">
        <label for="setting_static_url">静态文件 URL</label>
        <input type="text" class="form-control" id="setting_static_url" name="static_url"
               value="{if isset($settings['static_url'])}{$settings['static_url']}{/if}" placeholder="https://cdn.example.com/static/front 或 /public/static/front">
    </div>

                <!-- 表单按钮 -->
                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> 保存设置
                    </button>
                    <button type="reset" class="btn btn-secondary">
                        <i class="fas fa-redo"></i> 重置
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script nonce="{$csp_nonce}">
// 全局错误监听
window.onerror = function(message, source, lineno, colno, error) {
    console.error('全局JavaScript错误:', message, '文件:', source, '行号:', lineno, '列号:', colno, '错误对象:', error);
};

// 页面加载完成检查
console.log('页面JavaScript开始加载');

// 删除图片函数
function deleteImage(inputId, previewId, fieldName) {
    if (!confirm('确定要删除这张图片吗？')) {
        return;
    }
    
    const inputElement = document.getElementById(inputId);
    const previewElement = document.getElementById(previewId);
    
    // 如果是网站Logo或网站图标，向服务器发送请求删除对应的文件
    if (fieldName === 'site_logo' || fieldName === 'site_favicon') {
        const csrfToken = document.getElementById('csrf_token')?.value || '';
        
        // 发送AJAX请求通知服务器删除文件
        const formData = new FormData();
        formData.append('field_name', fieldName);
        formData.append('csrf_token', csrfToken);
        
        fetch('/admin/setting/delete-image', {
            method: 'POST',
            body: formData
        })
        .then(response => {
            return response.json();
        })
        .then(data => {
            if (data.code !== 0) {
                console.error('删除服务器图片失败:', data.message);
                alert('删除失败: ' + data.message);
                // 如果删除失败，恢复原来的内容
                if (inputElement && inputElement.dataset.originalValue) {
                    inputElement.value = inputElement.dataset.originalValue;
                }
                if (previewElement && inputElement && inputElement.dataset.originalValue) {
                    previewElement.innerHTML = '<img src="' + inputElement.dataset.originalValue + '" width="200" class="img-thumbnail" style="margin-bottom: 10px;">';
                }
            } else {
                // 仅在服务器成功删除后才真正清空UI
                if (inputElement) {
                    inputElement.value = '';
                }
                
                if (previewElement) {
                    previewElement.innerHTML = '';
                }
                
                alert('图片删除成功');
            }
        })
        .catch(error => {
            console.error('删除图片请求失败:', error);
            alert('删除请求失败: ' + error.message);
            // 如果请求失败，恢复原来的内容
            if (inputElement && inputElement.dataset.originalValue) {
                inputElement.value = inputElement.dataset.originalValue;
            }
            if (previewElement && inputElement && inputElement.dataset.originalValue) {
                previewElement.innerHTML = '<img src="' + inputElement.dataset.originalValue + '" width="200" class="img-thumbnail" style="margin-bottom: 10px;">';
            }
        });
    } else {
        // 如果不是受支持的字段，直接清空UI
        if (inputElement) {
            inputElement.value = '';
        }
        
        if (previewElement) {
            previewElement.innerHTML = '';
        }
    }
}

// 确保deleteImage函数可用
console.log('deleteImage函数已定义');

// 图片选择函数
function selectImage(inputId) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.style.display = 'none';
    
    input.onchange = function(e) {
        const file = e.target.files[0];
        if (!file) return;
        
        // 验证文件类型
        if (!file.type.match(/^image\/(jpeg|jpg|png|gif|webp|ico)$/)) {
            alert('请选择图片文件（jpg、png、gif、webp、ico）');
            return;
        }
        
        // 验证文件大小（最大 5MB）
        if (file.size > 5 * 1024 * 1024) {
            alert('图片大小不能超过 5MB');
            return;
        }
        
        // 创建 FormData
        const formData = new FormData();
        formData.append('file', file);
        formData.append('module', 'setting'); // 添加模块标识
        formData.append('field_name', inputId.replace('setting_', '')); // 添加字段名标识
        
        // 获取 CSRF Token
        const csrfToken = document.getElementById('csrf_token')?.value || '';
        formData.append('csrf_token', csrfToken);
        
        // 显示上传中提示
        const targetInput = document.getElementById(inputId);
        if (!targetInput) {
            alert('未找到目标输入框: ' + inputId);
            return;
        }
        const originalValue = targetInput.value;
        targetInput.value = '上传中...';
        targetInput.disabled = true;
        
        // 上传文件
        fetch('/admin/upload/do', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            targetInput.disabled = false;
            if (data.errno === 0 && data.data && data.data.length > 0) {
                // 上传成功，设置图片URL
                targetInput.value = data.data[0];
                // 显示预览
                const previewId = 'preview_' + inputId.replace('setting_', '');
                const preview = document.getElementById(previewId);
                if (preview) {
                    // 添加时间戳参数以避免缓存
                    const timestamp = new Date().getTime();
                    const imageUrl = data.data[0] + '?t=' + timestamp;
                    const fieldKey = inputId.replace('setting_', '');
                    
                    // 重新构建预览内容，包括图片和删除按钮
                    preview.innerHTML = '<img src="' + imageUrl + '" width="200" class="img-thumbnail" style="margin-bottom: 10px;">' +
                                      '<div class="mt-1">' +
                                      '<button type="button" class="btn btn-sm btn-danger" onclick="deleteImage(\'setting_' + fieldKey + '\', \'preview_' + fieldKey + '\', \'' + fieldKey + '\')">' +
                                      '<i class="fas fa-trash"></i> 删除图片</button>' +
                                      '</div>';
                }
            } else {
                // 上传失败
                targetInput.value = originalValue;
                alert(data.message || '上传失败');
            }
        })
        .catch(error => {
            targetInput.disabled = false;
            targetInput.value = originalValue;
            console.error('上传错误:', error);
            alert('上传失败，请重试');
        });
    };
    
    // 触发文件选择
    document.body.appendChild(input);
    input.click();
    document.body.removeChild(input);
}

// 表单提交处理
document.getElementById('settingForm')?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const originalText = button.innerHTML;
    
    // 禁用提交按钮，防止重复提交
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 保存中...';
    
    // 使用Fetch API提交表单
    fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.code === 0) {
            // 保存成功，显示提示并跳转
            if (data.message) {
                alert(data.message);
            }
            // 跳转到指定URL或刷新页面
            window.location.href = data.url || '/admin/setting';
        } else {
            // 保存失败，显示错误信息
            alert(data.message || '保存失败');
            // 恢复提交按钮
            button.disabled = false;
            button.innerHTML = originalText;
        }
    })
    .catch(error => {
        console.error('保存失败:', error);
        alert('保存失败，请重试');
        // 恢复提交按钮
        button.disabled = false;
        button.innerHTML = originalText;
    });
});
</script>

<style>
.setting-group {
    padding: 1.5rem;
    background-color: #f8f9fa;
    border-radius: 0.5rem;
    border: 1px solid #dee2e6;
}

.setting-group h5 {
    color: #495057;
    font-weight: 600;
}

.setting-group .form-group {
    margin-bottom: 1.5rem;
}

.setting-group .form-group:last-child {
    margin-bottom: 0;
}
</style>
{/block}
