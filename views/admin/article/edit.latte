{extends '../layout.latte'}

{block title}{$title}{/block}

{block content}
<div class="container-fluid">
    <!-- 页面顶部标题 -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">{$title}</h1>
        <a href="/admin/article" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> 返回列表
        </a>
    </div>
    
    <!-- 表单卡片 -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <form action="{$action}" method="post" enctype="multipart/form-data">
                <!-- CSRF Token -->
<input type="hidden" name="csrf_token" id="csrf_token" value="{$csrf_token}">
                
                <!-- 文章ID（编辑时使用） -->
                {if isset($article['id'])}
                <input type="hidden" name="id" value="{$article['id']}">
                {/if}
                
                <!-- 基础字段 -->
                <div class="mb-4">
                    <h5>基础信息</h5>
                    <hr>
                    
                    <!-- 标题 -->
                    <div class="form-group">
                        <label for="title">标题 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="title" name="title" value="{if isset($article['title'])}{$article['title']}{/if}" placeholder="请输入文章标题" required>
                    </div>
                    
                    <!-- 摘要 -->
                    <div class="form-group">
                        <label for="summary">摘要</label>
                        <textarea class="form-control" id="summary" name="summary" rows="3" placeholder="请输入文章摘要">{if isset($article['summary'])}{$article['summary']}{/if}</textarea>
                    </div>
                    
                    <!-- 两列布局：所属栏目、发布时间、封面图片、状态 -->
                    <div class="row">
                        <!-- 所属栏目 -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="category_id">所属栏目 <span class="text-danger">*</span></label>
                                <select class="form-control" id="category_id" name="category_id" required>
                                    <option value="">请选择栏目</option>
                                    {foreach $categories as $category}
                                    {var $level = (int)($category['level'] ?? 0)}
                                    {var $indent = str_repeat('&nbsp;&nbsp;', $level)}
                                    {var $categoryType = $category['type'] ?? 'article'}
                                    {var $selected = false}
                                    {if isset($article['category_id']) && $article['category_id'] == $category['id']}
                                        {var $selected = true}
                                    {elseif isset($pre_cid) && $pre_cid > 0 && $category['id'] == $pre_cid}
                                        {var $selected = true}
                                    {/if}
                                    <option value="{$category['id']}" data-type="{$categoryType}" {if $selected}selected{/if}>
                                        {$indent|noescape} - {$category['name']}
                                    </option>
                                    {if isset($category['children']) && count($category['children']) > 0}
                                    {foreach $category['children'] as $child}
                                    {var $childLevel = (int)($child['level'] ?? 0)}
                                    {var $childIndent = str_repeat('&nbsp;&nbsp;', $childLevel)}
                                    {var $childType = $child['type'] ?? 'article'}
                                    {var $childSelected = false}
                                    {if isset($article['category_id']) && $article['category_id'] == $child['id']}
                                        {var $childSelected = true}
                                    {elseif isset($pre_cid) && $pre_cid > 0 && $child['id'] == $pre_cid}
                                        {var $childSelected = true}
                                    {/if}
                                    <option value="{$child['id']}" data-type="{$childType}" {if $childSelected}selected{/if}>
                                        {$childIndent|noescape} - {$child['name']}
                                    </option>
                                    {/foreach}
                                    {/if}
                                    {/foreach}
                                </select>
                            </div>
                        </div>
                        
                        <!-- 发布时间 -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="published_at">发布时间</label>
                                <input type="datetime-local" class="form-control" id="published_at" name="published_at" value="{if isset($article['published_at_formatted'])}{$article['published_at_formatted']}{/if}">
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <!-- 封面图 -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="cover_img">封面图片</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="cover_img" name="cover_img" value="{if isset($article['cover_img'])}{$article['cover_img']}{/if}" placeholder="请输入图片URL">
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-secondary" onclick="selectImage()">选择图片</button>
                                        <button type="button" class="btn btn-outline-primary" onclick="selectImageWithCrop()">裁剪上传</button>
                                    </div>
                                </div>
                                {if isset($article['cover_img']) && $article['cover_img']}
                                <div class="mt-2" id="cover_img_preview">
                                    <img src="{$article['cover_img']}" width="200" class="img-thumbnail">
                                    <div class="mt-2">
                                        <button type="button" class="btn btn-danger btn-sm" onclick="deleteCoverImage()">删除封面图</button>
                                    </div>
                                </div>
                                {else}
                                <div class="mt-2" id="cover_img_preview"></div>
                                {/if}
                            </div>
                        </div>
                        
                        <!-- 状态 -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="status">状态</label>
                                <select class="form-control" id="status" name="status">
                                    <option value="1" {if (isset($article['status']) && $article['status'] == 1) || !isset($article['status'])}selected{/if}>已发布</option>
                                    <option value="0" {if isset($article['status']) && $article['status'] == 0}selected{/if}>草稿</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- 置顶和图片新闻字段 -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="is_top">是否置顶</label>
                            <select class="form-control" id="is_top" name="is_top">
                                <option value="0" {if (isset($article['is_top']) && $article['is_top'] == 0) || !isset($article['is_top'])}selected{/if}>否</option>
                                <option value="1" {if isset($article['is_top']) && $article['is_top'] == 1}selected{/if}>是</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="is_image_news">是否图片新闻</label>
                            <select class="form-control" id="is_image_news" name="is_image_news">
                                <option value="0" {if (isset($article['is_image_news']) && $article['is_image_news'] == 0) || !isset($article['is_image_news'])}selected{/if}>否</option>
                                <option value="1" {if isset($article['is_image_news']) && $article['is_image_news'] == 1}selected{/if}>是</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <!-- 内容编辑器 -->
                <div class="mb-4">
                    <h5>文章内容 <span class="text-danger">*</span></h5>
                    <hr>
                    <div id="toolbar"></div>
                    <div id="editor" style="min-height: 500px;"></div>
                    <textarea id="content" name="content" style="display: none;">{if isset($article['content'])}{$article['content']|noescape}{/if}</textarea>
                </div>
                
                <!-- 扩展字段区域 -->
                <div class="mb-4">
                    <h5>扩展信息</h5>
                    <hr>
                    <div id="extend-fields">
                        <!-- 动态生成的扩展字段将插入到这里 -->
                    </div>
                </div>
                
                <!-- 文章数据JSON，用于扩展字段加载 -->
                <input type="hidden" id="article_json" value="{if isset($article_json)}{$article_json}{else}null{/if}">
                                
                <!-- 文档附件管理 -->
                <div class="mb-4">
                    <h5>文档附件</h5>
                    <hr>
                    {if isset($article['id'])}
                        <div class="alert alert-info small">
                            支持上传的文档类型：PDF、Word、WPS、Excel、PowerPoint、TXT 等（扩展名：pdf, doc, docx, wps, dps, et, xls, xlsx, ppt, pptx, txt），单个文件最大 15MB。
                        </div>
                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnUploadDocument">
                                <i class="fas fa-upload"></i> 上传文档附件
                            </button>
                            <input type="file" id="documentFileInput" name="document_files[]" class="d-none" multiple>
                        </div>
                        <div id="article-attachments">
                            {if isset($attachments) && $attachments && count($attachments)}
                                <table class="table table-sm table-bordered align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px;">ID</th>
                                            <th>文件名</th>
                                            <th style="width: 120px;">大小 (KB)</th>
                                            <th style="width: 90px;">排序</th>
                                            <th>备注</th>
                                            <th style="width: 120px;">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {foreach $attachments as $file}
                                            {var $sizeKb = ceil((int)($file['size'] ?? 0) / 1024)}
                                            <tr data-id="{$file['id']}">
                                                <td>{$file['id']}</td>
                                                <td>
                                                    <a href="/file/download/{$file['id']}" target="_blank">{$file['original_name']}</a>
                                                </td>
                                                <td>{$sizeKb}</td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm attachment-sort" value="{$file['sort'] ?? 0}" data-id="{$file['id']}" min="0">
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control form-control-sm attachment-description" value="{ifset $file['description']}{$file['description']}{/ifset}" data-id="{$file['id']}">
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-primary btn-attachment-save" data-id="{$file['id']}">保存</button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-attachment-delete" data-id="{$file['id']}">删除</button>
                                                </td>
                                            </tr>
                                        {/foreach}
                                    </tbody>
                                </table>
                            {else}
                                <p class="text-muted mb-0">当前文章还没有文档附件。</p>
                            {/if}
                        </div>
                    {else}
                        <div class="alert alert-warning small mb-0">
                            请先保存文章，保存成功后可在编辑页面上传文档附件。
                        </div>
                    {/if}
                </div>
                                
                <!-- 表单按钮 -->
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> 保存
                    </button>
                    <a href="/admin/article" class="btn btn-secondary">
                        <i class="fas fa-times"></i> 取消
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>



<!-- 图片裁剪模态框 -->
<div class="modal fade" id="cropperModal" tabindex="-1" role="dialog" aria-labelledby="cropperModalLabel" aria-hidden="true" style="z-index: 20000;">
    <div class="modal-dialog modal-lg" role="document" style="z-index: 20001;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cropperModalLabel">裁剪图片</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-9 text-center" style="background-color: #333;">
                        <div class="img-container" style="width: 100%; max-height: 70vh; overflow: hidden;">
                            <img id="cropperImage" src="" style="max-width: 100%; display: block;">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="preview-lg mb-3" style="width: 150px; height: 210px; border: 1px solid #ddd; background: #f8f8f8; overflow: hidden; position: relative;"></div>
                        
                        <div class="form-group">
                            <label>预设比例</label>
                            <select class="form-control form-control-sm" id="aspectRatioSelect">
                                <option value="0">自由比例</option>
                                <option value="0.7143">150×210 (专家)</option>
                                <option value="1.7778">16×9 横图</option>
                                <option value="0.5625">9×16 竖图</option>
                                <option value="1">1×1 正方形</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label>目标尺寸</label>
                            <div class="row">
                                <div class="col-6">
                                    <input type="number" class="form-control form-control-sm" id="targetWidth" placeholder="宽" value="150">
                                </div>
                                <div class="col-6">
                                    <input type="number" class="form-control form-control-sm" id="targetHeight" placeholder="高" value="210">
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="d-flex align-items-center">
                                <input type="checkbox" id="lockAspectRatio" checked> 
                                <span class="ml-2">锁定比例</span>
                            </label>
                        </div>
                        
                        <div class="form-group">
                            <label>缩放操作</label>
                            <div class="btn-group btn-group-sm w-100" role="group">
                                <button type="button" class="btn btn-outline-secondary" onclick="zoomCropper(-0.1)" title="缩小">
                                    <i class="fas fa-minus"></i> 缩小
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="zoomCropper(0.1)" title="放大">
                                    <i class="fas fa-plus"></i> 放大
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="rotateCropper(-90)" title="左旋">
                                    <i class="fas fa-undo"></i> 左旋
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="rotateCropper(90)" title="右旋">
                                    <i class="fas fa-redo"></i> 右旋
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="resetCropper()" title="重置">
                                    <i class="fas fa-sync-alt"></i> 重置
                                </button>
                            </div>
                        </div>
                        
                        <div class="alert alert-info py-2 small">
                            <strong>操作提示：</strong><br>
                            • 滚轮缩放图片<br>
                            • 拖拽移动位置<br>
                            • 拖拽裁剪框调整大小
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="cropConfirmBtn">确认裁剪</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* 扩大裁剪模态框宽度，高度自适应 */
    #cropperModal .modal-dialog { max-width: 60vw; }
    #cropperModal .img-container { width:100%; height:70vh; max-height:70vh; }
    #cropperModal .img-container img { width:auto; height:100%; max-height:100%; object-fit:contain; }
</style>

<!-- WangEditor 富文本编辑器 CSS -->
<style>
    /* 修复编辑器层级过高的问题 */
    .w-e-toolbar { z-index: 1000 !important; }
    .w-e-text-container { z-index: 900 !important; }
    /* 确保模态框背景也在正确层级 */
    .modal-backdrop { z-index: 19999 !important; }
</style>
<link rel="stylesheet" href="/static/wangeditor/cdn/wangEditor.min.css">
<!-- Cropper.js CSS -->
<link rel="stylesheet" href="/static/cropperjs/cropper.min.css">

<!-- WangEditor 富文本编辑器 JS -->
<script src="/static/wangeditor/cdn/wangEditor.min.js"></script>
<!-- Cropper.js JS -->
<script src="/static/cropperjs/cropper.min.js"></script>
<!-- Image Crop JS -->
<script src="/static/js/image-crop.js"></script>
<!-- 文章编辑器功能 -->
<script src="/static/js/admin/article-editor.js"></script>
<!-- 扩展字段功能 -->
<script src="/static/js/admin/extend-fields.js"></script>

<!-- 文章文档附件管理 -->
<script n:syntax="off">
(function () {
    var uploadBtn = document.getElementById('btnUploadDocument');
    var fileInput = document.getElementById('documentFileInput');

    if (uploadBtn && fileInput) {
        uploadBtn.addEventListener('click', function () {
            fileInput.click();
        });

        fileInput.addEventListener('change', function () {
            if (!this.files || !this.files.length) {
                return;
            }

            var csrfInput = document.getElementById('csrf_token');
            var csrfToken = csrfInput ? csrfInput.value : '';
            var idInput = document.querySelector('input[name="id"]');
            var articleId = idInput ? idInput.value : '';

            if (!articleId) {
                alert('请先保存文章后再上传附件');
                uploadBtn.innerHTML = '<i class="fas fa-upload"></i> 上传文档附件';
                uploadBtn.disabled = false;
                return;
            }
            
            var files = this.files;
            var uploadedCount = 0;
            var totalCount = files.length;

            for (var i = 0; i < files.length; i++) {
                var formData = new FormData();
                formData.append('file', files[i]);
                formData.append('module', 'document');
                formData.append('related_type', 'article');
                formData.append('related_id', articleId);
                formData.append('file_usage', 'document');
                formData.append('csrf_token', csrfToken);

                fetch('/admin/upload/upload', {
                    method: 'POST',
                    body: formData,
                    credentials: 'same-origin'
                }).then(function (response) {
                    return response.json();
                }).then(function (data) {
                    // WangEditor upload response format - errno: 0, data: [url]
                    if (data && data.errno === 0) {
                        uploadedCount++;
                        // 显示进度
                        uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 上传中... (' + uploadedCount + '/' + totalCount + ')';
                    } else {
                        console.error('上传失败:', data && data.message ? data.message : '未知错误');
                        alert(data && data.message ? data.message : '上传失败: ' + files[i].name);
                    }
                }).catch(function (error) {
                    console.error('上传异常:', error);
                    alert('上传失败，请稍后重试: ' + files[i].name);
                }).finally(function() {
                    // 全部上传完成后刷新页面
                    if (uploadedCount === totalCount) {
                        setTimeout(function() {
                            window.location.reload();
                        }, 500);
                    }
                });
            }

            // 重置 input，避免同一文件无法再次选择
            this.value = '';
        });
    }

    // 保存单个附件信息
    $(document).on('click', '.btn-attachment-save', function () {
        var id = $(this).data('id');
        var row = $(this).closest('tr');
        var saveBtn = $(this);
        var originalText = saveBtn.text();
            
        // 显示保存状态
        saveBtn.html('<i class="fas fa-spinner fa-spin"></i>');
        saveBtn.prop('disabled', true);
    
        var sort = row.find('.attachment-sort').val() || 0;
        var description = row.find('.attachment-description').val() || '';
        var articleId = $('input[name="id"]').val() || 0;
        var csrfToken = $('#csrf_token').val() || '';
    
        $.post('/admin/file/update', {
            id: id,
            related_type: 'article',
            related_id: articleId,
            file_usage: 'document',
            is_primary: 0,
            sort: sort,
            description: description,
            csrf_token: csrfToken
        }, function (res) {
            if (res && res.code === 0) {
                alert('保存成功');
            } else {
                alert(res && res.message ? res.message : '保存失败');
            }
        }, 'json').always(function() {
            // 恢复按钮状态
            saveBtn.html(originalText);
            saveBtn.prop('disabled', false);
        });
    });

    // 删除附件
    $(document).on('click', '.btn-attachment-delete', function () {
        if (!confirm('确定要删除该附件吗？')) {
            return;
        }
    
        var deleteBtn = $(this);
        var originalText = deleteBtn.text();
            
        // 显示删除状态
        deleteBtn.html('<i class="fas fa-spinner fa-spin"></i>');
        deleteBtn.prop('disabled', true);
    
        var id = deleteBtn.data('id');
        var csrfToken = $('#csrf_token').val() || '';
    
        $.post('/admin/file/delete/' + id, {
            csrf_token: csrfToken
        }, function (res) {
            if (res && res.code === 0) {
                window.location.reload();
            } else {
                alert(res && res.message ? res.message : '删除失败');
                // 如果删除失败，恢复按钮状态
                deleteBtn.html(originalText);
                deleteBtn.prop('disabled', false);
            }
        }, 'json').fail(function() {
            alert('删除失败，请稍后重试');
            // 如果请求失败，恢复按钮状态
            deleteBtn.html(originalText);
            deleteBtn.prop('disabled', false);
        });
    });
})();
</script>
{/block}