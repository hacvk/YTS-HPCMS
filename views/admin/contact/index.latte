{extends '../../admin/layout.latte'}

{block title}{$title}{/block}

{block content}
<div class="container-fluid">
    <!-- 页面顶部标题 -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">{$title}</h1>
    </div>
    
    <!-- 联系方式设置表单 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-address-book"></i> 联系方式设置
            </h6>
        </div>
        <div class="card-body">
            <form id="contactForm" action="{$admin_path}/contact/save" method="post">
                <!-- CSRF Token -->
                <input type="hidden" name="csrf_token" id="csrf_token" value="{$csrf_token}">
                <input type="hidden" id="admin_path_value" value="{$admin_path}">
                
                <div class="setting-group mb-4">
                    <h5 class="mb-3 border-bottom pb-2">
                        <i class="fas fa-info-circle"></i> 联系信息
                    </h5>
                    
                    {foreach $contact_fields as $fieldKey => $field}
                    <div class="form-group mb-3">
                        <label for="contact_{$fieldKey}">
                            {$field['label']}
                            {if isset($field['required']) && $field['required']}
                            <span class="text-danger">*</span>
                            {/if}
                        </label>
                        
                        {if $field['type'] == 'textarea'}
                        <textarea 
                            class="form-control" 
                            id="contact_{$fieldKey}" 
                            name="{$fieldKey}" 
                            rows="3"
                            {if isset($field['required']) && $field['required']}required{/if}
                        >{if isset($settings[$fieldKey])}{$settings[$fieldKey]}{/if}</textarea>
                        
                        {elseif $field['type'] == 'email'}
                        <input 
                            type="email" 
                            class="form-control" 
                            id="contact_{$fieldKey}" 
                            name="{$fieldKey}" 
                            value="{if isset($settings[$fieldKey])}{$settings[$fieldKey]}{/if}" 
                            placeholder="请输入{$field['label']}"
                            {if isset($field['required']) && $field['required']}required{/if}
                        >
                        
                        {elseif $field['type'] == 'image'}
                        <div class="input-group">
                            <input 
                                type="text" 
                                class="form-control" 
                                id="contact_{$fieldKey}" 
                                name="{$fieldKey}" 
                                value="{if isset($settings[$fieldKey])}{$settings[$fieldKey]}{/if}" 
                                placeholder="请输入{$field['label']}"
                            >
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary js-select-image" data-input-id="contact_{$fieldKey|noescape}">
                                    <i class="fas fa-image"></i> 选择图片
                                </button>
                            </div>
                        </div>
                        {if isset($settings[$fieldKey]) && $settings[$fieldKey]}
                        <div class="mt-2">
                            <img src="{$settings[$fieldKey]}" width="200" class="img-thumbnail" id="preview_{$fieldKey}">
                        </div>
                        {else}
                        <div class="mt-2" id="preview_{$fieldKey}"></div>
                        {/if}
                        
                        {else}
                        <input 
                            type="text" 
                            class="form-control" 
                            id="contact_{$fieldKey}" 
                            name="{$fieldKey}" 
                            value="{if isset($settings[$fieldKey])}{$settings[$fieldKey]}{/if}" 
                            placeholder="请输入{$field['label']}"
                            {if isset($field['required']) && $field['required']}required{/if}
                        >
                        {/if}
                        
                        {if isset($field['help'])}
                        <small class="form-text text-muted">{$field['help']}</small>
                        {/if}
                    </div>
                    {/foreach}
                </div>
                
                <!-- 表单按钮 -->
                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> 保存设置
                    </button>
                    <button type="reset" class="btn btn-secondary">
                        <i class="fas fa-redo"></i> 重置
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script nonce="{$csp_nonce}">
// 规范化后台路径（防止配置中意外包含引号）
const adminPath = (function () {
    var el = document.getElementById('admin_path_value');
    var raw = el ? el.value : '/admin';
    return raw.replace(/^\"+|\"+$/g, '').replace(/\/+$/, '');
})();

// 图片选择函数
function selectImage(inputId) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.style.display = 'none';
    
    input.onchange = function(e) {
        const file = e.target.files[0];
        if (!file) return;
        
        // 验证文件类型
        if (!file.type.match(/^image\/(jpeg|jpg|png|gif|webp|ico)$/)) {
            alert('请选择图片文件（jpg、png、gif、webp、ico）');
            return;
        }
        
        // 验证文件大小（最大 5MB）
        if (file.size > 5 * 1024 * 1024) {
            alert('图片大小不能超过 5MB');
            return;
        }
        
        // 创建 FormData
        const formData = new FormData();
        formData.append('file', file);
        formData.append('module', 'contact'); // 添加模块标识
        
        // 获取 CSRF Token
        const csrfToken = document.getElementById('csrf_token')?.value || '';
        formData.append('csrf_token', csrfToken);
        
        // 显示上传中提示
        const targetInput = document.getElementById(inputId);
        if (!targetInput) {
            alert('未找到目标输入框: ' + inputId);
            return;
        }
        const originalValue = targetInput.value;
        targetInput.value = '上传中...';
        targetInput.disabled = true;
        
        // 上传文件
        fetch(adminPath + '/upload/do', {
            method: 'POST',
            body: formData,
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            const contentType = response.headers.get('content-type') || '';
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }
            if (contentType.indexOf('application/json') === -1) {
                throw new Error('响应不是JSON，可能已登录失效');
            }
            return response.json();
        })
        .then(data => {
            targetInput.disabled = false;
            if (data.errno === 0 && data.data && data.data.length > 0) {
                // 上传成功，设置图片URL
                targetInput.value = data.data[0];
                // 显示预览
                const previewId = 'preview_' + inputId.replace('contact_', '');
                const preview = document.getElementById(previewId);
                if (preview) {
                    var timestamp = new Date().getTime();
                    var imageUrl = data.data[0] + '?t=' + timestamp;
                    preview.innerHTML = '<img src="' + imageUrl + '" width="200" class="img-thumbnail">';
                }
            } else {
                // 上传失败
                targetInput.value = originalValue;
                alert(data.message || '上传失败');
            }
        })
        .catch(error => {
            targetInput.disabled = false;
            targetInput.value = originalValue;
            console.error('上传错误:', error);
            alert('上传失败，请重试');
        });
    };
    
    // 触发文件选择
    document.body.appendChild(input);
    input.click();
    document.body.removeChild(input);
}

// 表单提交处理
document.getElementById('contactForm')?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const originalText = button.innerHTML;
    
    // 禁用提交按钮，防止重复提交
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 保存中...';
    
    // 使用Fetch API提交表单
    fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        credentials: 'same-origin',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => {
        const contentType = response.headers.get('content-type') || '';
        if (!response.ok) {
            throw new Error('HTTP ' + response.status);
        }
        if (contentType.indexOf('application/json') === -1) {
            throw new Error('响应不是JSON，可能已登录失效');
        }
        return response.json();
    })
    .then(data => {
        if (data.code === 0) {
            // 保存成功，显示提示并跳转
            if (data.message) {
                alert(data.message);
            }
            // 跳转到指定URL或刷新页面
            window.location.href = data.url || '{$admin_path}/contact';
        } else {
            // 保存失败，显示错误信息
            alert(data.message || '保存失败');
            // 恢复提交按钮
            button.disabled = false;
            button.innerHTML = originalText;
        }
    })
    .catch(error => {
        console.error('保存失败:', error);
        alert('保存失败，请重试');
        // 恢复提交按钮
        button.disabled = false;
        button.innerHTML = originalText;
    });
});

// 事件委托（避免 CSP 阻止内联事件）
document.addEventListener('click', function (event) {
    var target = event.target;
    if (!target) {
        return;
    }
    var selectBtn = target.closest ? target.closest('.js-select-image') : null;
    if (selectBtn) {
        var inputId = selectBtn.getAttribute('data-input-id');
        if (inputId) {
            selectImage(inputId);
        }
    }
});
</script>

<style>
.setting-group {
    padding: 1.5rem;
    background-color: #f8f9fa;
    border-radius: 0.5rem;
    border: 1px solid #dee2e6;
}

.setting-group h5 {
    color: #495057;
    font-weight: 600;
}
</style>
{/block}
