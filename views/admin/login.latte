<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{$title|noescape}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .login-container {
            background: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 400px;
        }

        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .login-header h1 {
            color: #333;
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .login-header p {
            color: #666;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            color: #333;
            font-weight: 500;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
            transition: border-color 0.3s;
        }

        .form-group input:focus {
            outline: none;
            border-color: #667eea;
        }

        .form-group input::placeholder {
            color: #999;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .login-footer {
            text-align: center;
            margin-top: 20px;
            color: #999;
            font-size: 12px;
        }

        @media (max-width: 480px) {
            .login-container {
                padding: 30px 20px;
            }

            .login-header h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h1>{$system['name'] ?? '后台管理系统'}</h1>
            <p>请登录您的账号</p>
        </div>

        <form action="{$admin_path}/login" method="POST">
            <input type="hidden" name="csrf_token" value="{$csrf_token}">

            <div class="form-group">
                <label for="username">用户名</label>
                <input 
                    type="text" 
                    id="username" 
                    name="username" 
                    placeholder="请输入用户名"
                    required
                    autocomplete="username"
                >
            </div>

            <div class="form-group">
                <label for="password">密码</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    placeholder="请输入密码"
                    required
                    autocomplete="current-password"
                >
            </div>

                        <div class="form-group">
                <label for="captcha">验证码</label>
                <div style="display:flex;align-items:center;gap:10px;">
                    <input 
                        type="text" 
                        id="captcha" 
                        name="captcha" 
                        placeholder="请输入验证码"
                        required
                        maxlength="5"
                        style="flex:1;"
                    >
                    <img 
                        src="{$admin_path}/login/captcha" 
                        alt="验证码" 
                        id="captchaImg" 
                        style="cursor:pointer;height:40px;border-radius:6px;"
                    >
                </div>
            </div>

            <button type="submit" class="btn-submit">登 录</button>
            <script nonce="{$csp_nonce}">
                // 点击验证码图片刷新
                document.getElementById('captchaImg').addEventListener('click', function () {
                    this.src = '{$admin_path}/login/captcha?rand=' + Date.now();
                });
                
                // 登录失败时自动刷新验证码
                document.querySelector('form').addEventListener('submit', function (e) {
                    // 阻止默认提交，使用 AJAX
                    e.preventDefault();
                    
                    const formData = new FormData(this);
                    const captchaImg = document.getElementById('captchaImg');
                    const submitBtn = document.querySelector('.btn-submit');
                    
                    // 禁用提交按钮，防止重复提交
                    submitBtn.disabled = true;
                    submitBtn.textContent = '登录中...';
                    
                    fetch(this.action, {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => {
                        // 检查响应状态
                        if (!response.ok) {
                            throw new Error('网络错误: ' + response.status);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.code !== 0) {
                            // 登录失败，刷新验证码
                            captchaImg.src = '{$admin_path}/login/captcha?rand=' + Date.now();
                            // 清空验证码输入框
                            document.getElementById('captcha').value = '';
                            // 显示错误提示
                            alert(data.message);
                        } else {
                            // 登录成功，跳转
                            if (data.url) {
                                window.location.href = data.url;
                            } else {
                                window.location.href = '{$admin_path}/dashboard';
                            }
                        }
                    })
                    .catch(error => {
                        console.error('登录失败:', error);
                        captchaImg.src = '{$admin_path}/login/captcha?rand=' + Date.now();
                        document.getElementById('captcha').value = '';
                        alert('登录失败：' + error.message);
                    })
                    .finally(() => {
                        // 恢复提交按钮
                        submitBtn.disabled = false;
                        submitBtn.textContent = '登 录';
                    });
                });
            </script>
        </form>

        <div class="login-footer">
            {$system['copyright'] ?? '&copy; 2026 YYCMS. All rights reserved.'|noescape}
        </div>
    </div>
</body>
</html>
