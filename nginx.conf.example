# Nginx 配置示例
# 请将此配置添加到你的 Nginx 站点配置文件中

server {
    listen 80;
    server_name yycms.com;
    root /path/to/yycms/public;
    index index.php index.html;

    # 字符集
    charset utf-8;

    # 访问日志
    access_log /var/log/nginx/yycms_access.log;
    error_log /var/log/nginx/yycms_error.log;

    # 静态文件直接访问
    location ~* \.(css|js|jpg|jpeg|png|gif|ico|woff|woff2|ttf|svg|map)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    # 处理 PHP 请求
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP-FPM 配置
    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;  # 或 unix:/var/run/php/php8.2-fpm.sock
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # 禁止访问隐藏文件
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # 禁止访问敏感文件
    location ~* (\.env|\.git|\.md|composer\.json|composer\.lock|package\.json)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss;
    gzip_min_length 1000;
}
