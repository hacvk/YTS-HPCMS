{extends 'layout.latte'}

{block content}
<div class="crumbs">
    <div class="auto auto_1150"> <em>您的当前位置：</em>首页 > 文章详情 </div>
</div>

<div class="auto auto_1150">
  <div class="w22 fl"> 
    {include 'right_channel.latte'} 
  </div>
  <div class="w75 fr"> 
    <!--Artinfo star-->
    <div class="Artinfo">
      <div class="auto auto_1150">
        <article class="news-details auto w_96">
          <div id="print-area">
            <div class="title">
              <h1>{$article['title']}</h1>
              <aside>
                <span>发布时间：{date('Y-m-d H:i', strtotime($article['published_at']))}</span>
                <span>阅读次数：{$article['views'] ?? 0} 次</span>
                <span>【字号：<a href="javascript:SetFont(20)">大</a> <a href="javascript:SetFont(18)">中</a> <a href="javascript:SetFont(16)">小</a>】</span>
              </aside>
            </div>
            <div class="edit-info" id="news_content">
              {if isset($article['content'])}
                {$article['content']|noescape}
              {else}
                内容字段尚未增加
              {/if}
            </div>
          </div>
        
          <div class="pn-page">
            <div class="operating">
              <a class="a-print" href="javascript:void(0);">打印本页</a>
              <a class="a-close" href="javascript:void(0);" onClick="closeWindow();">关闭窗口</a>
            </div>
            
            <!-- 上下篇链接 - 需要在控制器中获取 -->
            {ifset $prevArticle}
              <aside class="dot">上一篇:<a href="/article/{$prevArticle['id']}">{$prevArticle['title']}</a></aside>
            {/ifset}
            
            {ifset $nextArticle}
              <aside class="dot">下一篇:<a href="/article/{$nextArticle['id']}">{$nextArticle['title']}</a></aside>
            {/ifset}
          </div>
        </article>
      </div>
    </div>
    <!--Artinfo end--> 
  </div>
  <div class="clear"></div>
</div>

<script>
//设置字体 
function SetFont(size)
{
  var divBody = document.getElementById("news_content");
  if(!divBody)
  {
    return;
  }
  divBody.style.fontSize = size + "px";
  var divChildBody = divBody.childNodes;
  for(var i = 0; i < divChildBody.length; i++)
  {
    if (divChildBody[i].nodeType==1)
    {
      divChildBody[i].style.fontSize = size + "px";
    }
  }
}
$(".a-print").click(function(){
    $("#print-area").printArea();
});
 function closeWindow() {
    var userAgent = navigator.userAgent;
    if (userAgent.indexOf("Firefox") != -1 || userAgent.indexOf("Chrome") != -1) {
        location.href = "about:blank";
    } else {
        window.opener = null;
        window.open('', '_self');
    }
    window.close();
}
</script>
{/block}