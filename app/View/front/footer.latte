{* app/View/front/footer.latte *}
<div class="footer_dyseo">
    <div class="auto auto_1150">
        <dl>
            <dt><a href="javascript:;">友情链接</a></dt>
            <dd class="clearfix">
                {ifset $friendLinksHtml}
                    {$friendLinksHtml|noescape}
                {else}
                    {friendLinks()|noescape}
                {/ifset}
            </dd>
        </dl>

        <div class="footer clearfix">
            <div class="share fr">
                <ul class="ul clearfix">
                    <ol>
                        <aside>分享关注：</aside>
                        <div class="bshare-custom">
                            <div class="bsPromo bsPromo2"></div>
                            <a title="分享到新浪微博" class="bshare-sinaminiblog"></a>
                            <a title="分享到微信" class="bshare-weixin"></a>
                        </div>
                    </ol>
                    <li><img src="{$qrCodeUrl ?? ''}"></li>
                </ul>
            </div>

            <div class="copyright fl" style="position:relative;">
                <a style="position:absolute;left:0;top:0;width:100px;height:100%;z-index:5;" target="_blank" href="{$orgPlatformUrl ?? '#'}"></a>
                &copy; {=date('Y')} {$hospitalName ?? ''}
                <a id="icp_record" href="//beian.miit.gov.cn" target="_blank">{$icpRecord ?? ''}</a>
                <a style="color: #bcbec0;" href="http://www.beian.gov.cn/portal/registerSystemInfo?recordcode={$policeRecordCode ?? ''}">
                    <img src="{asset('static/front/images/gaba.png')}" style="vertical-align: middle; display: inline-block;">{$policeRecord ?? ''}
                </a>
                <p>乘车方式：{$traffic ?? ''}</p>
                <p>院址：{$address ?? ''} 邮编:{$zip ?? ''}&emsp;服务热线：{$phone ?? ''}&emsp;举报电话：{$reportPhone ?? ''}</p>
            </div>
        </div>
    </div>
</div>

<script>
    $(function ($) {
        $(window).on("resize", function (e) {
            $(".footer_dyseo .select-group dl").each(function () {
                var a = $(this).find("dt").width(),
                    b = $(this).find("dt").find("a").outerWidth(),
                    c = Math.round(((a - b) / 2) / a * 0.8 * 100) + "%";
                $(this).find("dt").find("span").width(c)
            });
        }).trigger("resize");
    });

    $(".footer_dyseo .select-group dl").each(function () {
        $(this).find("dt").click(function () {
            $(this).next("dd").toggle();
            $(this).parent("dl").toggleClass("on");
        });
        $(this).mouseleave(function () {
            $(this).find("dd").hide();
            $(this).removeClass("on");
        });
    });
</script>

<div class="foot_nav">
    <button></button>
    <a href="#" class="icon1">
        官方微信
        <span class="img-box">
            <img src="{$wechatQrUrl ?? ''}" alt="">
        </span>
    </a>
    <a href="/jiuzhenzhinan/" class="icon2">来院路线</a>
    <a href="{$onlineServiceUrl ?? ''}" class="icon3">在线客服</a>
    <a href="javascript:void(0);" onclick="$('body,html').animate({ scrollTop: 0 },500);" class="top"><b>TOP</b>回到顶部</a>
</div>

<script>
    if ($(window).width() < 769) {
        var asideShow = true;
        $('.foot_nav button').click(function () {
            $(this).toggleClass('active');
            if (asideShow) {
                $('.foot_nav').stop().animate({ right: '0' }, 300);
            } else {
                $('.foot_nav').stop().animate({ right: '-70px' }, 300);
            }
            asideShow = !asideShow
        })
    }
</script>
